<Window x:Class="duHastNet.DocManager.Revit.Views.SheetCustomPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vms="clr-namespace:duHastNet.DocManager.Revit.ViewModels"
        mc:Ignorable="d"
        Title="Import Sheets — Custom Properties"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Height="500"
        Width="900"
        MinHeight="350"
        MinWidth="600"
        d:DataContext="{d:DesignInstance Type=vms:SheetCustomPropertiesViewModel, IsDesignTimeCreatable=False}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Summary -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="15,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Document Manager"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Enter custom property values for the sheets being imported."
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="3">
            <TextBlock>
                <Run Text="{Binding SummaryLabel}" FontWeight="SemiBold"/>
                <Run Text=" — custom field values left blank will be stored as empty strings."/>
            </TextBlock>
        </Border>

        <!-- DataGrid — static columns declared here; custom field columns injected in code-behind -->
        <DataGrid x:Name="SheetsDataGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding SheetRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="LightGray"
                  AlternatingRowBackground="#F9F9F9"
                  RowHeight="30"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Doc Number"
                                    Binding="{Binding DocumentNumber}"
                                    Width="160"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Doc Name"
                                    Binding="{Binding DocumentName}"
                                    Width="*"
                                    IsReadOnly="True"/>

                <DataGridTextColumn Header="Current Rev."
                                    Binding="{Binding CurrentRevision}"
                                    Width="100"
                                    IsReadOnly="True"/>

                <!-- Custom field columns are inserted here by code-behind -->

            </DataGrid.Columns>
        </DataGrid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Confirm Import"
                    Command="{Binding ConfirmCommand}"
                    Width="130"
                    Height="30"
                    Margin="0,0,10,0"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Height="30"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
