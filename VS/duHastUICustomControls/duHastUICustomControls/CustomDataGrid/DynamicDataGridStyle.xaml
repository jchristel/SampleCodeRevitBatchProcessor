<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid"
                    xmlns:converters="clr-namespace:duHastNet.UI.CustomControls.Converters">


    <!-- Add the converter as a resource -->
    <converters:StringContainsConverter x:Key="StringContainsConverter"/>

    <!-- Enhanced FilterableColumnHeaderStyle with triggers -->
    <Style x:Key="FilterableColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Style.Triggers>
            <!-- This trigger will be set programmatically -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="HasFilter">
                <Setter Property="Background" Value="#FFCDD2"/>
                <Setter Property="Foreground" Value="#D32F2F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="ReadOnly">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="Foreground" Value="#757575"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Alternative: Separate styles for each state -->
    <Style x:Key="FilteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FilterableColumnHeaderStyle}">
        <Setter Property="Background" Value="#FFCDD2"/>
        <Setter Property="Foreground" Value="#D32F2F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ReadOnlyColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FilterableColumnHeaderStyle}">
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="Foreground" Value="#757575"/>
    </Style>

    <!-- Default Read-Only Cell Style -->
    <Style x:Key="DefaultReadOnlyColumnStyle" TargetType="DataGridCell">
        <!-- This style intentionally has no setters - cells look normal -->
    </Style>

    <!-- DataGrid control style with built-in loading overlay -->
    <Style TargetType="{x:Type local:DynamicDataGrid}">
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DynamicDataGrid}">
                    <Grid>
                        <!-- The actual DataGrid (using base DataGrid template) -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                             Grid.Column="1"
                                                                             Visibility="{Binding HeadersVisibility, 
                                                                                 ConverterParameter={x:Static DataGridHeadersVisibility.Column}, 
                                                                                 Converter={x:Static DataGrid.HeadersVisibilityConverter}, 
                                                                                 RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>

                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                    Grid.Row="1"
                                                                    Grid.ColumnSpan="2"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       Grid.Column="2"
                                                       Grid.Row="1"
                                                       Orientation="Vertical"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                       Grid.Row="2"
                                                       Grid.Column="1"
                                                       Orientation="Horizontal"
                                                       Maximum="{TemplateBinding ScrollableWidth}"
                                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        
                        <!-- Loading Overlay (integrated from LoadingOverlay control) -->
                        <Border x:Name="PART_LoadingOverlay">
                            <Border.Background>
                                <SolidColorBrush Color="White" Opacity="0.8"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy, RelativeSource={RelativeSource TemplatedParent}}" 
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            
                            <StackPanel HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                <!-- Loading text -->
                                <TextBlock Text="{TemplateBinding LoadingMessage}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,10"/>
                                
                                <!-- Animated barcode container -->
                                <Border Width="200" 
                                        Height="40" 
                                        BorderBrush="#666666" 
                                        BorderThickness="1"
                                        Background="White"
                                        CornerRadius="2"
                                        ClipToBounds="True">
                                    <Canvas Width="400" Height="40">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="PART_BarcodeTransform"/>
                                        </Canvas.RenderTransform>
                                        <Canvas.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="PART_BarcodeTransform"
                                                                         Storyboard.TargetProperty="X"
                                                                         From="0" 
                                                                         To="-200"
                                                                         Duration="0:0:2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Canvas.Triggers>
                                        
                                        <!-- Barcode pattern -->
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="0"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="12"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="20"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="36"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="44"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="56"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="64"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="80"/>
                                        
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="100"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="112"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="120"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="136"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="144"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="156"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="164"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="180"/>
                                        
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="200"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="212"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="220"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="236"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="244"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="256"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="264"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="280"/>
                                        
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="300"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="312"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="320"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="336"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="344"/>
                                        <Rectangle Fill="Black" Width="4" Height="40" Canvas.Left="356"/>
                                        <Rectangle Fill="Black" Width="12" Height="40" Canvas.Left="364"/>
                                        <Rectangle Fill="Black" Width="8" Height="40" Canvas.Left="380"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column Header Context Menu Style -->
    <Style x:Key="ColumnHeaderContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column Header Menu Item Style -->
    <Style x:Key="ColumnHeaderMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="Black"/>
        <!-- Default black text -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
            <!-- Red styling for Remove items -->
            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                               Converter={StaticResource StringContainsConverter}, 
                               ConverterParameter='Remove'}" Value="True">
                <Setter Property="Foreground" Value="#F44336"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <!-- Filter items stay black (no special trigger needed since black is default) -->
        </Style.Triggers>
    </Style>
    
    <!-- Column Header Separator Style -->
    <Style x:Key="ColumnHeaderSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>
    
    <!-- Row Context Menu Style -->
    <Style x:Key="BulkSelectionContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Item Styles for bulk operations -->
    <Style x:Key="BulkOperationMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>

            <!-- Different styling for different operation types -->
            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                                   Converter={StaticResource StringContainsConverter}, 
                                   ConverterParameter='Check Selected'}" Value="True">
                <Setter Property="Foreground" Value="#4CAF50"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                                   Converter={StaticResource StringContainsConverter}, 
                                   ConverterParameter='Uncheck Selected'}" Value="True">
                <Setter Property="Foreground" Value="#F44336"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Separator style -->
    <Style x:Key="BulkOperationSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

</ResourceDictionary>