<Window x:Class="duHastNet.DocManager.UI.Shared.Views.AddNewDocumentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
        xmlns:vm="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels"
        xmlns:converters="clr-namespace:duHastNet.DocManager.UI.Shared.Converters"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Height="600"
        Width="1200"
        MinHeight="400"
        MinWidth="800"
        d:DataContext="{d:DesignInstance Type=vm:AddNewDocumentsDialogViewModel}">

    <Window.Resources>
        <converters:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
        <converters:NumberMatchesTooltipConverter x:Key="NumberMatchesTooltipConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Add New Documents to Database" 
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 10"/>

        <!-- Summary -->
        <Border Grid.Row="1" 
                Background="#F0F0F0"
                Padding="10"
                Margin="0 0 0 10"
                CornerRadius="3">
            <TextBlock>
                <Run Text="Total: " FontWeight="SemiBold"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text="  |  "/>
                <Run Text="Ready to Add: " FontWeight="SemiBold" Foreground="Green"/>
                <Run Text="{Binding ReadyToAddCount, Mode=OneWay}" Foreground="Green"/>
                <Run Text="  |  "/>
                <Run Text="Duplicates: " FontWeight="SemiBold" Foreground="Red"/>
                <Run Text="{Binding DuplicateCount, Mode=OneWay}" Foreground="Red"/>
            </TextBlock>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="DocumentsDataGrid"
                  Grid.Row="2" 
                  ItemsSource="{Binding DocumentRows}"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="LightGray"
                  AlternatingRowBackground="#F9F9F9"
                  RowHeight="30"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <!-- Status Indicator -->
                <DataGridTemplateColumn Header="" Width="30" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" 
                                     Height="12" 
                                     Fill="{Binding StatusColor}"
                                     ToolTip="{Binding StatusMessage}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- File Name -->
                <DataGridTextColumn Header="File Name" 
                                    Binding="{Binding FileName}" 
                                    Width="200"
                                    IsReadOnly="True"/>

                <!-- File Extension -->
                <DataGridTextColumn Header="Extension" 
                                    Binding="{Binding FileExtension}" 
                                    Width="80"
                                    IsReadOnly="True"/>

                <!-- Proposed Document Number - EDITABLE -->
                <DataGridTextColumn Header="Proposed Doc Number" 
                                    Binding="{Binding ProposedDocumentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Width="180"
                                    IsReadOnly="False"/>

                <!-- Proposed Document Name - EDITABLE -->
                <DataGridTextColumn Header="Proposed Doc Name" 
                                    Binding="{Binding ProposedDocumentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Width="250"
                                    IsReadOnly="False"/>

                <!-- Number Matches Filename -->
                <DataGridTemplateColumn Header="Number Matches Filename" Width="150" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NumberMatchesFileName, Converter={StaticResource BoolToYesNoConverter}}"
                                       HorizontalAlignment="Center"
                                       ToolTip="{Binding NumberMatchesFileName, Converter={StaticResource NumberMatchesTooltipConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status -->
                <DataGridTextColumn Header="Status" 
                                    Binding="{Binding StatusMessage}" 
                                    Width="*"
                                    MinWidth="150"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0 10 0 0">
            <Button Content="Add to Database"
                    Command="{Binding OkCommand}"
                    Width="120"
                    Height="30"
                    Margin="0 0 10 0"
                    IsDefault="True"/>

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Height="30"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
