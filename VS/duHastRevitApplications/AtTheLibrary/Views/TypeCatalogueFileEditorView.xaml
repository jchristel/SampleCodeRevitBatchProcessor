<UserControl x:Class="duHastNet.AtTheLibrary.Views.TypeCatalogueFileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.AtTheLibrary.Views"
             xmlns:utilsViews ="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.0"
             xmlns:celleditor="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls.25.0.1.0"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <!-- Add your UI elements here -->
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- safe and cancel -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Border 
            Grid.Row="0" 
            Background="#2196F3" 
            Padding="15,10" 
            Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="At The Library" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Foreground="White"/>
                <TextBlock Text="Type catalogue file editor" 
                    FontSize="12" 
                    Foreground="White" 
                    Opacity="0.9"/>
            </StackPanel>
        </Border>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- dynamic cell editor to show type data -->
        <celleditor:CellEditor
            x:Name="CellEditorControl"
            Grid.Row="2"
            HeaderRow="{Binding HeaderRow}"
            DataRows="{Binding DataRows}"
            ReadOnlyColumns="{Binding ReadOnlyColumns}"
            AllowAddRow="True"
            AllowDuplicateRow="True"
            AllowDeleteRow="True"
            BorderBrush="Gray"
            BorderThickness="1"/>
        
        <!-- close and save buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                Margin="0 5 5 5" 
                Content="Close"
                Command="{Binding SelectFamiliesCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="1"
                Margin="0 5 5 5" 
                Content="Save"
                Command="{Binding SaveCatalogueTextFileDataCommand}"
                CommandParameter="{Binding ElementName=CellEditorControl}"/>
        </Grid>
    </Grid>
</UserControl>
