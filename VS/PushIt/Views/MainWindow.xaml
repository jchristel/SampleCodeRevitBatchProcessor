<Window x:Class="duHast.PushIt.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHast.PushIt"
             xmlns:views="clr-namespace:duHast.PushIt.Views"
             xmlns:vms="clr-namespace:duHast.PushIt.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
            Title="PushIt" Height="450" Width="800"
            FontSize="14">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:RoomsSelectionViewModel}">
                <views:RoomsSelection/>
            </DataTemplate>
        </Grid.Resources>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
