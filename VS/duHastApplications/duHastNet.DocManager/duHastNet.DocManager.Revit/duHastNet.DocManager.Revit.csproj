<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Set target framework -->
		<TargetFramework>net8.0-windows</TargetFramework>

		<!-- Include WPF -->
		<UseWPF>true</UseWPF>
		<!-- Enable implicit usings -->
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Enable nullable reference types -->
		<Nullable>enable</Nullable>

		<!-- Target x64 platform only -->
		<Platforms>x64</Platforms>
		<!-- Ensure platform target is x64 -->
		<PlatformTarget>x64</PlatformTarget>

		<!-- Copy NuGet dependencies to output -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- Assembly metadata (optional - customize as needed) -->
		<AssemblyName>DocManagerRevit.25.0.1.1</AssemblyName>
		<AssemblyVersion>25.0.1.1</AssemblyVersion>
		<FileVersion>25.0.1.1</FileVersion>
		<AssemblyTitle>docManager Revit Integration</AssemblyTitle>
		<Product>DocManager Revit</Product>
		<Company>duHast</Company>

		<!-- Match your build script's expected path -->
		<OutputPath>bin\x64\$(Configuration)\</OutputPath>

		<!-- Prevent the target framework folder (net8.0-windows) from being appended -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- Keep runtime identifier out of the output path but select win-x64 assets -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<!-- Don't generate .deps.json file (not needed for Revit plugins) -->
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<!-- Ensure only the win-x64 runtime assets are copied to the output -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<!-- Project references -->
		<ProjectReference Include="..\duHastNet.DocManager.Core\duHastNet.DocManager.Core.csproj" />
		<ProjectReference Include="..\duHastNet.DocManager.UI.Shared\duHastNet.DocManager.UI.Shared.csproj" />

		<!-- Revit API references - not copied to output (Private=False) -->
		<Reference Include="RevitAPI">
			<HintPath>..\\..\\..\\_References\\Autodesk\\RevitAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="RevitAPIUI">
			<HintPath>..\\..\\..\\_References\\Autodesk\\RevitAPIUI.dll</HintPath>
			<Private>False</Private>
		</Reference>
    <!-- utility dll reference -->
    <Reference Include="Utils.25.0.1.1">
      <HintPath>..\\..\\..\\_References\\duHast\\Utils.25.0.1.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
	</ItemGroup>

	<ItemGroup>
	  <None Update="ListDocuments.py">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>