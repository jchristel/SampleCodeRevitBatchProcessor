<UserControl x:Class="duHastNet.PushIt.Views.DataSource.DrofusDataSourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="0 4 0 4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Base URL -->
            <RowDefinition Height="Auto"/>  <!-- Database name -->
            <RowDefinition Height="Auto"/>  <!-- Project number -->
            <RowDefinition Height="Auto"/>  <!-- API token -->
            <RowDefinition Height="Auto"/>  <!-- Connect + status -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Base URL -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Base URL:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. https://api.hidd.health.nsw.gov.au or https://apiau.drofus.com"/>

        <!-- Database name -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Database:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. hi-alburycr"/>

        <!-- Project number -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Project number:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding ProjectNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. 01"/>

        <!-- API token -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="API token:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Paste your API token from the drofus Power Query credentials dialog"/>

        <!-- Connect button + status -->
        <StackPanel Grid.Row="4" Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0 8 0 0">

            <Button Content="Connect"
                    Padding="16 4"
                    Command="{Binding ConnectCommand}"/>

            <!-- Shown while connecting -->
            <TextBlock Text="Connecting…"
                       Margin="10 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="#555"
                       Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>

            <!-- Status: green on success, red on failure, hidden while connecting -->
            <TextBlock Margin="10 0 0 0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="260">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#CC0000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Foreground" Value="#007700"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>
    </Grid>
</UserControl>
