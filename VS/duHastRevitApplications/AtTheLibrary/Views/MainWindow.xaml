<Window x:Class="duHastNet.AtTheLibrary.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.AtTheLibrary"
             xmlns:views="clr-namespace:duHastNet.AtTheLibrary.Views"
             xmlns:vms="clr-namespace:duHastNet.AtTheLibrary.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
            Title="At The Library" Height="450" Width="800"
            FontSize="14">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:FamiliesSelectionViewModel}">
                <views:FamiliesSelectionView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:ParametersSelectionViewModel}">
                <views:ParametersSelectionView/>
            </DataTemplate>
        </Grid.Resources>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
