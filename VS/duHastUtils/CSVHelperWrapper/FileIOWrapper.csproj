<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>duHastNet.FileIOWrapper</RootNamespace>
    <AssemblyName>FileIOWrapper.25.0.1.0</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Match your build script's expected path -->
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <!-- Disable automatic framework folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet dependencies to output -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>
</Project>