<UserControl x:Class="duHastNet.AtTheLibrary.Views.FamiliesSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.AtTheLibrary.Views"
             xmlns:utilsViews ="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.23.0.0.3"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.23.0.0.3"
             xmlns:dynamicDataGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <StackPanel>
                            <Border
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ItemsControl Margin="0 1 0 0" FontSize="12" ItemsSource="{TemplateBinding Validation.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent}" Foreground="Red"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--boolean converters-->
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <!-- Add your UI elements here -->
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- refresh / model status -->
            <RowDefinition Height="auto"/>
            <!-- admin expander -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="At the library" FontSize="24"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageBanner DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- dynamic grid view of room data -->
        <dynamicDataGrid:DynamicDataGrid  
            x:Name="dataGrid" 
            Grid.Row="2"
            DataContext="{Binding  FamiliesDataGridViewModel}"
            ItemsSource="{Binding Data}"
            ColumnDefinitions="{Binding ColumnDefinitions}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedItem}"
            Margin="5 10 5 10"
            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableColumnManagement="True"
            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableBulkSelection="False"
            IsEnabled="{Binding IsWaitingForRevitCommandToFinish, Converter={StaticResource InverseBooleanConverter}}">

            <!-- Add Row Style for conditional formatting -->
            <dynamicDataGrid:DynamicDataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <!-- Default background -->
                    <Setter Property="Background" Value="Red" />
                    <Style.Triggers>

                        <!-- Color rows based on a "Count" column -->
                        <DataTrigger Binding="{Binding Values[Count]}" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Values[Count]}" Value="1">
                            <Setter Property="Background" Value="LightGray"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </dynamicDataGrid:DynamicDataGrid.RowStyle>
        </dynamicDataGrid:DynamicDataGrid>
        <!-- button row content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                Margin="0 5 5 5" 
                Content="Refresh families from model"
                Command="{Binding RefreshGUICommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="1"
                Margin="0 5 5 5" 
                Content="Load family into model"
                Command="{Binding LoadFamilyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="2"
                Margin="0 5 5 5" 
                Content="Edit Type Catalogue"
                Command="{Binding EditTypeCatalogueFileCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="3"
                Margin="0 5 5 5" 
                Content="Edit family"
                Command="{Binding OpenFamilyIntoUICommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
        <!-- admin model data expander -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Data Admin" Margin="5 5 5 5">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                            Grid.Column="0"
                            Margin="0 10 5 10"
                            Padding="0 0 5 0"
                            Text="Path to SoA:" />
                        <TextBox
                            x:Name="FilePathTextBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5 10 5 10"
                            Text="{Binding DataFilePath, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                        <Button 
                            Grid.Row="0" 
                            Grid.Column="2" 
                            Padding="20 0 20 0"
                            Margin="5 10 0 10" 
                            Content="Browse"
                            Click="PickFile_OnClick"/>
                        <Button 
                            Grid.Row="0" 
                            Grid.Column="3" 
                            Padding="20 0 20 0"
                            Margin="5 10 0 10" 
                            Content="Load"
                            Command="{Binding ReloadDataCommand}" 
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                    <Border CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button 
                                    Grid.Row="1" 
                                    Grid.Column="2" 
                                    Padding="20 0 20 0"
                                    Margin="5 10 5 10" 
                                    Content="Filter Available Parameters"
                                    Command="{Binding SelectParameters}" 
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            />
                        </Grid>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>
    </Grid>
</UserControl>
