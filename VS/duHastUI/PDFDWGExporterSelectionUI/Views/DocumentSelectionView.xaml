<UserControl x:Class="duHastNet.UI.PDFDWGExporterSelectionUI.Views.DocumentSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.UI.PDFDWGExporterSelectionUI.Views"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.23.0.0.3"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.23.0.0.3"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--converters-->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- Header row -->
            <RowDefinition Height="Auto"/>
            <!-- message banner -->
            <RowDefinition Height="Auto"/>
            <!-- document type selector -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- buttons export import-->
            <RowDefinition Height="Auto"/>
            <!-- buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Grid Grid.Row="0" Margin="0 0 0 10">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Export Documents" FontSize="24"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageBanner DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>
        <!-- Print set selection -->
        <Grid Grid.Row="2">
            <!-- document type selection ComboBox -->
            <ComboBox
                Margin="5 5 5 5" 
                ItemsSource="{Binding PrintSetNamesDefaultList}"
                SelectedValue="{Binding Path=SelectedPrintSet,Mode=TwoWay}"/>
        </Grid>
        <!-- Sheet selection -->
        <Grid Grid.Row="3">
            <!-- grid view -->
            <DataGrid Grid.Row="3" x:Name="dataGrid" 
                    ItemsSource="{Binding DataViewSheets}"
                    EnableRowVirtualization="True" 
                    EnableColumnVirtualization="True" 
                    VirtualizingPanel.IsVirtualizing="True" 
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    AutoGenerateColumns="True" 
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    SelectionMode="Extended" 
                    ColumnWidth="*"
                    RowHeight="23"
                    HorizontalAlignment="Stretch"
                    ColumnReordered="RoomsDataGrid_ColumnReordered">
            </DataGrid>
        </Grid>
        <!--Export path -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Margin="0 10 5 10"
                 Padding="0 0 5 0"
                 Text="Export Path:" />
            <TextBox
                 x:Name="ExportFilePathTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Margin="5 10 5 10"
                 Text="{Binding ExportSheetsFilePath, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Button 
                 Grid.Row="0" 
                 Grid.Column="2" 
                 Padding="20 0 20 0"
                 Margin="5 10 5 10" 
                 Content="Browse"
                 Click="Export_OnClick"/>
        </Grid>
        <!-- export row content -->
        <Border Grid.Row="5" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                     Margin="2 5 2 5" 
                     Content="Export Sheets" 
                     FontSize="24"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
