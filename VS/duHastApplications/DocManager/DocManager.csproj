<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Utils.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.0.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="duHastUICustomControls.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\duHastUICustomControls.25.0.0.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
</Project>