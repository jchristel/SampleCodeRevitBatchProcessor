<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.MetaDataAconexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <!-- meta data file path-->
                <RowDefinition Height="Auto" />
                <!-- field mapping table -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <!-- meta data file path-->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                        Margin="5 10 5 10"
                        Padding="5"
                        Text="Template Meta Data File Path:" />
                    <TextBox Grid.Column="1"
                             Padding="5"
                            x:Name="TemplateMetaDateFilePathTextBox"
                            Margin="5 10 5 10"
                            Text="{Binding TemplateMetaDataFilePath, UpdateSourceTrigger=PropertyChanged}"
                            />
                <Button Grid.Column="2"
                        Margin="5 10 5 10"
                        Padding="5"
                        Content="Browse"
                        Command="{Binding BrowseTemplateFileCommand}"
                        IsEnabled="{Binding IsBrowseTemplateFileEnabled}"
                        />
                
            </Grid>

            <!-- field mapping table -->
            <Grid Grid.Row="1">
            </Grid>

        </Grid>
    </Grid>
</UserControl>
