<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:duHastNet.UI.CustomControls"
                    xmlns:converters="clr-namespace:duHastNet.UI.CustomControls.Converters">


    <!-- Converter: Enum <-> Slider.Value -->
    <converters:SwitchStateToValueConverter x:Key="SwitchConverter"/>

    <!-- Style for the ThreeWaySwitch control -->
    <Style TargetType="{x:Type local:ThreeWaySwitch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ThreeWaySwitch}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Display Name -->
                        <TextBlock Text="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}" 
                            Grid.Row="0" HorizontalAlignment="Center" FontWeight="Bold"/>

                        <!-- Slider -->
                        <Slider x:Name="PART_Slider"
                            Grid.Row="1"
                            Minimum="0"
                            Maximum="2"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource SwitchConverter}}"
                            Margin="10,10,10,0" />

                        <!-- Labels -->
                        <Grid Grid.Row="2" Margin="10,5,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding LabelLeft, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="0" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding LabelCenter, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="1" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LabelRight, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="2" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>