<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Set target framework -->
		<TargetFramework>net8.0</TargetFramework>
		
		<!-- Enable implicit usings -->
		<ImplicitUsings>enable</ImplicitUsings>
		
		<!-- Enable nullable reference types -->
		<Nullable>enable</Nullable>
		
		<!-- Target x64 platform only -->
		<Platforms>x64</Platforms>
		<!-- Ensure platform target is x64 -->
		<PlatformTarget>x64</PlatformTarget>

		<!-- Copy NuGet dependencies to output -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- Set assembly version information -->
		<AssemblyVersion>1.0.4.0</AssemblyVersion>
		<FileVersion>1.0.4.0</FileVersion>
		<Version>1.0.4</Version>
		
		<!-- Prevent the target framework folder (net8.0) from being appended -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- Keep runtime identifier out of the output path but select win-x64 assets -->
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<!-- Don't generate .deps.json file (not needed for class library) -->
		<GenerateDependencyFile>false</GenerateDependencyFile>

		<!-- Ensure only the win-x64 runtime assets are copied to the output -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<ItemGroup>
		<!-- NuGet package references -->
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
	</ItemGroup>
</Project>