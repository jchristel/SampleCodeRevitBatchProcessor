<UserControl x:Class="duHastNet.PushIt.Views.DataSource.DrofusDataSourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="500">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!--
            Row template for the mapping ListView.
            Three text columns plus a warning indicator that appears when either
            RevitParameterMissing or DrofusFieldMissing is true.
        -->
        <DataTemplate x:Key="MappingRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>   <!-- warning indicator -->
                    <ColumnDefinition Width="20"/>   <!-- id indicator -->
                    <ColumnDefinition Width="*"/>    <!-- drofus field -->
                    <ColumnDefinition Width="*"/>    <!-- Revit parameter -->
                    <ColumnDefinition Width="Auto"/> <!-- direction — never clipped -->
                    <ColumnDefinition Width="80"/>   <!-- Revit precedence checkbox -->
                </Grid.ColumnDefinitions>

                <!-- Warning indicator -->
                <TextBlock Grid.Column="0"
                           Text="⚠"
                           Foreground="#CC7700"
                           FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="This mapping has a validation warning. Check drofus field name and Revit parameter GUID."
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>

                <!-- Id indicator -->
                <TextBlock Grid.Column="1"
                           Text="🔑"
                           FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="This mapping is the unique identifier used to match drofus rooms."
                           Visibility="{Binding IsUniqueId, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding DrofusFieldLabel}"
                           FontWeight="{Binding RowFontWeight}"
                           VerticalAlignment="Center"
                           Margin="4 2 8 2"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DrofusFieldName}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding RevitParameterName}"
                           FontWeight="{Binding RowFontWeight}"
                           VerticalAlignment="Center"
                           Margin="0 2 8 2"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RevitParameterName}"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding FlowDirectionDisplay}"
                           FontWeight="{Binding RowFontWeight}"
                           VerticalAlignment="Center"
                           Margin="0 2 8 2"
                           ToolTip="{Binding FlowDirectionDisplay}"/>

                <!-- Revit takes precedence after initial split push -->
                <CheckBox Grid.Column="5"
                          IsChecked="{Binding RevitTakesPrecedenceAfterInitialPush, Mode=TwoWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          ToolTip="When checked, after the first push to a split room Revit's value is used on all subsequent pushes (SoA value is ignored for this property)."/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0 4 0 4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Base URL -->
            <RowDefinition Height="Auto"/>  <!-- Database name -->
            <RowDefinition Height="Auto"/>  <!-- Project number -->
            <RowDefinition Height="Auto"/>  <!-- API token -->
            <RowDefinition Height="Auto"/>  <!-- Save / Load settings -->
            <RowDefinition Height="Auto"/>  <!-- Connect + status -->
            <RowDefinition Height="Auto"/>  <!-- Configuration selector (visible when connected + HasConfigurations) -->
            <RowDefinition Height="Auto"/>  <!-- Mapping panel (visible when connected) -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Base URL ──────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Base URL:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. https://api.hidd.health.nsw.gov.au or https://apiau.drofus.com"/>

        <!-- ── Database name ─────────────────────────────────────────────── -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Database:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding DatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. hi-alburycr"/>

        <!-- ── Project number ───────────────────────────────────────────── -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Project number:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding ProjectNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="e.g. 01"/>

        <!-- ── API token ─────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="API token:"
                   VerticalAlignment="Center"
                   Margin="0 4 8 4"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Margin="0 4 0 4"
                 Text="{Binding ApiToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Paste your API token from the drofus Power Query credentials dialog"/>

        <!-- ── Save / Load settings ──────────────────────────────────────── -->
        <StackPanel Grid.Row="4" Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0 4 0 4">

            <Button Content="Save Settings"
                    Padding="14 3"
                    Margin="0 0 6 0"
                    Command="{Binding SaveSettingsToFileCommand}"
                    ToolTip="Save current drofus settings to a file for sharing with team members"/>

            <Button Content="Load Settings"
                    Padding="14 3"
                    Command="{Binding LoadSettingsFromFileCommand}"
                    ToolTip="Load drofus settings from a file — only the drofus block is applied"/>

        </StackPanel>

        <!-- ── Connect button + status ──────────────────────────────────── -->
        <StackPanel Grid.Row="5" Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="0 8 0 0">

            <Button Content="Connect"
                    Padding="16 4"
                    Command="{Binding ConnectCommand}"/>

            <!-- Shown while connecting -->
            <TextBlock Text="Connecting…"
                       Margin="10 0 0 0"
                       VerticalAlignment="Center"
                       Foreground="#555"
                       Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVis}}"/>

            <!-- Status: green on success, red on failure, hidden while connecting -->
            <TextBlock Margin="10 0 0 0"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="260">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#CC0000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Foreground" Value="#007700"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>

        <!-- ── Attribute configuration selector ─────────────────────────── -->
        <!--
            Shown only when connected AND at least one room attribute configuration
            is available (HasConfigurations). When HasConfigurations is false the
            entire selector collapses — the mapping interface is also disabled in
            that state (Scenario 1 / Gap 2).
        -->
        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
              Margin="0 8 0 0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsConnected}" Value="True"/>
                                <Condition Binding="{Binding HasConfigurations}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Configuration:"
                       VerticalAlignment="Center"
                       Margin="0 4 8 4"
                       ToolTip="Select the drofus room attribute configuration to use as the field source for mappings"/>
            <ComboBox Grid.Column="1"
                      Margin="0 4 0 4"
                      ItemsSource="{Binding AvailableConfigurations}"
                      SelectedItem="{Binding SelectedConfiguration, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      ToolTip="The active configuration determines which drofus fields are available in the mapping dialog"/>
        </Grid>

        <!-- ── Mapping panel — visible only when connected ──────────────── -->
        <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="0 12 0 0"
                BorderBrush="#CCCCCC"
                BorderThickness="0 1 0 0"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">

            <StackPanel Margin="0 8 0 0">

                <!-- Section header + validation warning badge -->
                <StackPanel Orientation="Horizontal" Margin="0 0 0 6">
                    <TextBlock Text="Property Mappings"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Warning badge — shown when any mapping has a validation issue -->
                    <Border Background="#FFF3CD"
                            BorderBrush="#FFEAA7"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="8 0 0 0"
                            Padding="6 2"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasValidationWarnings, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠ Some mappings have validation warnings"
                                   Foreground="#856404"
                                   FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Column headers -->
                <Grid Margin="0 0 0 2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>   <!-- warning indicator -->
                        <ColumnDefinition Width="20"/>   <!-- id indicator -->
                        <ColumnDefinition Width="*"/>    <!-- drofus field -->
                        <ColumnDefinition Width="*"/>    <!-- Revit parameter -->
                        <ColumnDefinition Width="Auto"/> <!-- direction -->
                        <ColumnDefinition Width="80"/>   <!-- Revit precedence -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2"
                               Text="drofus Field"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="4 0 8 0"
                               Foreground="#555"
                               ToolTip="Human-readable field name from the drofus catalogue. Hover a row to see the raw JSON field id."/>
                    <TextBlock Grid.Column="3"
                               Text="Revit Parameter"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0 0 8 0"
                               Foreground="#555"/>
                    <TextBlock Grid.Column="4"
                               Text="Direction"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Margin="0 0 4 0"
                               Foreground="#555"/>
                    <TextBlock Grid.Column="5"
                               FontWeight="SemiBold"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#555"
                               ToolTip="Revit takes precedence after initial push to a split room">
                        <Run Text="Revit"/><LineBreak/><Run Text="Precedence"/>
                    </TextBlock>
                </Grid>

                <!-- Mapping ListView — scrolls after 10 rows -->
                <ListView ItemsSource="{Binding MappingRows}"
                          SelectedItem="{Binding SelectedMappingRow, Mode=TwoWay}"
                          ItemTemplate="{StaticResource MappingRowTemplate}"
                          MinHeight="60"
                          MaxHeight="240"
                          BorderThickness="1"
                          BorderBrush="#CCCCCC"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch"
                          IsEnabled="{Binding HasConfigurations}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4 2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Add / Edit / Remove buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 6 0 0">

                    <Button Content="Add"
                            Padding="14 3"
                            Margin="0 0 6 0"
                            Command="{Binding AddMappingCommand}"/>

                    <Button Content="Edit"
                            Padding="14 3"
                            Margin="0 0 6 0"
                            IsEnabled="{Binding HasConfigurations}"
                            Command="{Binding EditMappingCommand}"/>

                    <Button Content="Remove"
                            Padding="14 3"
                            IsEnabled="{Binding HasConfigurations}"
                            Command="{Binding RemoveMappingCommand}"/>

                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
