<UserControl x:Class="duHastNet.UI.PDFDWGExporterSelectionUI.Views.DocumentSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.UI.PDFDWGExporterSelectionUI.Views"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.0.1"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.0.1"
             xmlns:customControls="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls.25.0.0.1"
             xmlns:dynamicDataGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.0.1"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <StackPanel>
                            <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ItemsControl Margin="0 1 0 0" FontSize="12" ItemsSource="{TemplateBinding Validation.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent}" Foreground="Red"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--converters-->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- Header row -->
            <RowDefinition Height="Auto"/>
            <!-- message banner -->
            <RowDefinition Height="Auto"/>
            <!-- print set selector -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- export path -->
            <RowDefinition Height="Auto"/>
            <!-- Export doc type selectot-->
            <RowDefinition Height="Auto"/>
            <!-- Export sheet buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Grid Grid.Row="0" Margin="0 0 0 10">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Export Documents" FontSize="24"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageBanner DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>
        <!-- Print set selection -->
        <Border Grid.Row="2" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- header row -->
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Grid.Column="0" 
                    Grid.Row="0" 
                    Margin="5 5 5 5"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Text="Print Set"/>
                <!-- document type selection ComboBox -->
                <ComboBox Grid.Row="0" Grid.Column="1"
                    Margin="5 5 5 5" 
                    ItemsSource="{Binding PrintSetNamesDefaultList}"
                    SelectedValue="{Binding Path=SelectedPrintSet,Mode=TwoWay}"/>
            </Grid>
        </Border>
        <!-- Sheet selection -->
        <Grid Grid.Row="3">
            <!-- grid view -->
            <dynamicDataGrid:DynamicDataGrid  x:Name="dataGrid" 
                Grid.Row="0"
                DataContext="{Binding  ViewSelectionDataGridViewModel}"
                ItemsSource="{Binding Data}"
                ColumnDefinitions="{Binding ColumnDefinitions}"
                SelectionMode="Extended"
                dynamicDataGrid:DataGridColumnHeaderBehavior.EnableColumnManagement="True"
                dynamicDataGrid:DataGridColumnHeaderBehavior.EnableBulkSelection="True"/>
            
        </Grid>
        <!--Export path -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Margin="0 10 5 10"
                 Padding="5 0 5 0"
                 Text="Export Path:" />
                <TextBox
                    x:Name="ExportFilePathTextBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5 10 5 10"
                    Text="{Binding ExportSheetsFilePath, 
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged,
                           ValidatesOnNotifyDataErrors=True,
                           NotifyOnValidationError=True}"/>
                <Button 
                 Grid.Row="0" 
                 Grid.Column="2" 
                 Padding="20 0 20 0"
                 Margin="5 10 5 10" 
                 Content="Browse"
                 Click="Export_OnClick"/>
            </Grid>
        </Border>
        <!--export format selector -->
        <Border Grid.Row="5" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <customControls:ThreeWaySwitch Width="Auto" 
                Height="Auto"
                Margin="10 2 10 2"
                LabelLeft="Export PDF(s)" LabelCenter="Export DWG(s)" LabelRight="Export PDF(s) and DWG(s)" DisplayName="Export Mode"
                Value="{Binding ExportTypes, Mode=TwoWay}"/>
        </Border>
        
        <!-- export row content -->
        <Border Grid.Row="6" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                     Margin="2 5 2 5" 
                     Content = "{Binding  ExportButtonText}"
                     Command="{Binding SaveAndCloseCommand}"
                     CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                     FontSize="24"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
