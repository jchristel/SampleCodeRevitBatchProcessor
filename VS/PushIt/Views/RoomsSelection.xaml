<UserControl x:Class="PushIt.Views.RoomsSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PushIt.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10 10 10 10">
        <!-- Add your UI elements here -->
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- filter -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- refresh / model status -->
            <RowDefinition Height="auto"/>
            <!-- admin expander -->
            <RowDefinition Height="auto"/>
            <!-- push it buttons -->
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="PushIt..Real Good(tm)" FontSize="24"/>
            <ToggleButton x:Name = "toggleSafety" 
                Content = "LL"   
                Margin = "0 10 0 10"
                Width = "108"
                HorizontalAlignment = "Right">
            </ToggleButton>

        </Grid>
        <!-- filter -->
        <Border Grid.Row="1" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Expander Header="Filters" Margin="5 5 5 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Margin="0 5 5 5"
                    Text="Select Column" />
                    <ComboBox Grid.Row="1"
                    Grid.Column="0"
                    Margin="0 5 5 5" />
                    <TextBlock Grid.Row="0"
                    Grid.Column="1"
                    Margin="5 5 0 5"
                    Text="Enter filter value" />
                    <!-- filter value -->
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5 5 0 5"
                        Text=""/>
                </Grid>
            </Expander>
        </Border>
        <!-- grid view -->
        <ListView 
            Grid.Row="2" 
            Margin="0 25 0 0" 
            ItemsSource="{Binding Rooms}"
            SelectionMode="Single"
            SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <!-- room id column -->
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Room Id"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="0 0 20 0" Text="{Binding Id}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- area briefed column -->
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Area Briefed"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="0 0 20 0" Text="{Binding  AreaBriefed}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- Area Designed column -->
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Area Designed" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="0 0 20 0" Text="{Binding  AreaDesigned}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- RoomName Short -->
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Room Name Short" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Padding="0 0 20 0" Text="{Binding NameShort}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- department -->
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Department" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" Padding="0 0 20 0" Text="{Binding Department}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Subdepartment" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" Padding="0 0 20 0" Text="{Binding SubDepartment}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumnHeader Content="Count" />
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center" Padding="0 0 20 0" Text="{Binding Count}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <!-- button row content -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                Margin="0 5 5 5" 
                Content="Refresh rooms from model"
                Command="{Binding RefreshGUICommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Grid.Column="1"
                Margin="0 5 5 5" 
                Content="Highlight rooms in model"/>
            <TextBlock Grid.Column="2" Margin="5 5 0 5" Text="Stuff"/>
        </Grid>
        <!-- admin model data expander -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Data Admin" Margin="5 5 5 5">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button 
                            Grid.Row="0" 
                            Grid.Column="0"
                            Margin="0 10 5 10" 
                            Content="Update rooms in model"/>
                        <Button 
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5 10 0 10" 
                            Content="Wipe stale data from rooms in model"/>
                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                            Grid.Column="0"
                            Margin="0 10 5 10"
                            Padding="0 0 5 0"
                            Text="Path to SoA:" />
                        <Button 
                            Grid.Row="0" 
                            Grid.Column="2" 
                            Padding="20 0 20 0"
                            Margin="5 10 0 10" 
                            Content="Load"/>
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5 10 5 10"
                            Text="TRest"/>
                    </Grid>
                    <Border CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
                        <Expander  Header="Settings" Margin="5 5 5 5">
                            <ScrollViewer  Margin="5" HorizontalScrollBarVisibility="Auto">
                                <ListView 
                                    MinWidth="400" 
                                    Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}}}"
                                    MinHeight="200"
                                    Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ScrollContentPresenter}}}"
                                    >
                                    <ListView.View>
                                        <GridView>
                                            <!-- select to reload column -->
                                            <GridViewColumn>
                                                <GridViewColumnHeader Content="Select" />
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Padding="0 0 20 0" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <!-- category name column -->
                                            <GridViewColumn>
                                                <GridViewColumnHeader Content="Category Name"/>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Padding="0 0 20 0" Text="ff"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>
        <!-- push it button row content -->
        <Grid Grid.Row="5">
            <Button  
                Margin="0 10 0 10" 
                Content="Push It!" 
                FontSize="24"
                Command="{Binding PushSingleRoomCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>
    </Grid>
</UserControl>
