<UserControl x:Class="duHastNet.DocManager.UI.Shared.Controls.ModifierControls.ReplaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Controls.ModifierControls"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.2"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:ValidationErrorConverter x:Key="ValidationErrorConverter"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Margin="0">
        <!-- Find (Old Value) -->
        <TextBlock Text="Find:" 
                   Margin="0 0 0 5"
                   VerticalAlignment="Center"/>

        <TextBox Text="{Binding OldValue, 
                        UpdateSourceTrigger=PropertyChanged, 
                        ValidatesOnNotifyDataErrors=True}"
                 Width="350"
                 HorizontalAlignment="Left"
                 Padding="5"
                 Margin="0 0 0 10"
                 ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"/>

        <!-- Replace With (New Value) -->
        <TextBlock Text="Replace with:" 
                   Margin="0 0 0 5"
                   VerticalAlignment="Center"/>

        <TextBox Text="{Binding NewValue, 
                        UpdateSourceTrigger=PropertyChanged, 
                        ValidatesOnNotifyDataErrors=True}"
                 Width="350"
                 HorizontalAlignment="Left"
                 Padding="5"
                 ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"/>

        <!-- Help Text -->
        <TextBlock Text="Example: Replace 'ABC' with 'XYZ' in 'ABC-123' ? 'XYZ-123'"
                   FontSize="10"
                   Foreground="Gray"
                   Margin="0 5 0 0"
                   TextWrapping="Wrap"
                   Width="350"
                   HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
