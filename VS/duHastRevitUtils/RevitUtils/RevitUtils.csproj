<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>duHastNet.RevitUtils</RootNamespace>
    <AssemblyName>RevitUtils.25.0.1.2</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Suppress assembly version conflict warnings -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Auto-generate binding redirects -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Revit 2025 API References (.NET 8), compile only: not copied to output -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.20" ExcludeAssets="runtime" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.20" ExcludeAssets="runtime" PrivateAssets="All" />
  </ItemGroup>

  <!-- Reference to your converted Utils library -->
  <ItemGroup>
    <Reference Include="Utils.25.0.1.2">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.1.2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FileIOWrapper.25.0.1.2">
      <HintPath>..\\..\\_References\\duHast\\FileIOWrapper.25.0.1.2.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>