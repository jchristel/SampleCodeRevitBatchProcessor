<UserControl x:Class="duHastNet.DocManager.UI.Shared.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared"
             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- future user control resources-->
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
    </UserControl.Resources>

    <!-- main grid -->
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- date selection merger-->
            <RowDefinition Height="*"/>
            <!-- settings current documents -->
            <RowDefinition Height="auto"/>
            <!-- settings aconex -->
            <RowDefinition Height="auto"/>
            <!-- settings database -->
            <RowDefinition Height="auto"/>
            <!-- buttons -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- header row content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Document Manager" FontSize="24"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            
        </Grid>
        <!-- merger date picker -->
        <Grid Grid.Row="2">

        </Grid>
        <!-- current documents management expander -->
        <Border Grid.Row="3" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Current Documents" Margin="5 5 5 5">
            </Expander>
        </Border>
        <!-- aconex management expander -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Aconex" Margin="5 5 5 5">
            </Expander>
        </Border>
        <!-- database management expander -->
        <Border Grid.Row="5" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Database" Margin="5 5 5 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- data base path -->
                        <RowDefinition Height="Auto" />
                        <!-- document import export -->
                        <RowDefinition Height="Auto" />
                        <!-- document custom property fields -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- data base path connecting and creating -->
                    <Border Grid.Row="0" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
                        <StackPanel>
                            <!-- browse and connect to database -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0 10 5 10"
                                    Padding="0 0 5 0"
                                    Text="Path to Database:" />
                                <TextBox
                                    x:Name="FilePathTextBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="5 10 5 10"
                                    />
                                <Button 
                                    Grid.Row="0" 
                                    Grid.Column="2" 
                                    Padding="20 0 20 0"
                                    Margin="5 10 0 10" 
                                    Content="Browse"
                                    />
                                <Button 
                                    Grid.Row="0" 
                                    Grid.Column="3" 
                                    Padding="20 0 20 0"
                                    Margin="5 10 5 10" 
                                    Content="Connect"
                                    />
                            </Grid>
                            <!-- create database-->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button 
                                     Grid.Row="0" 
                                     Grid.Column="0" 
                                     Padding="20 0 20 0"
                                     Margin="5 10 0 10" 
                                     Content="Create Database"
                                     />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- document import and export -->
                    <Border Grid.Row="1" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                Margin="0 10 5 10" 
                                Content="Import Documents"
                            />
                            <Button Grid.Column="1"
                                Margin="0 10 5 10" 
                                Content="Export Documents"
                            />
                        </Grid>
                    </Border>
                    <!-- document custom property fields -->
                    <Border Grid.Row="2" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
                        <Expander  Header="Custom Fields" Margin="5 5 5 5">
                        </Expander>
                    </Border>
                </Grid>
            </Expander>
        </Border>
        <!-- main buttons -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!--- merge buttons -->
            <Border Grid.Row="0" Grid.RowSpan="3" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            </Border>
            <Button  Grid.Row="1"
                Margin="5 10 5 10" 
                Content = "Merge Documents"  
                FontSize="24"/>
        </Grid>
    </Grid>
</UserControl>
