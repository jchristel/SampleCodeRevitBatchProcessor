<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid"
                    xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters">


    <!-- Add the converter as a resource -->
    <converters:StringContainsConverter x:Key="StringContainsConverter"/>

    <!-- Enhanced FilterableColumnHeaderStyle with triggers -->
    <Style x:Key="FilterableColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Style.Triggers>
            <!-- This trigger will be set programmatically -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="HasFilter">
                <Setter Property="Background" Value="#FFCDD2"/>
                <Setter Property="Foreground" Value="#D32F2F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="ReadOnly">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="Foreground" Value="#757575"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Alternative: Separate styles for each state -->
    <Style x:Key="FilteredColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FilterableColumnHeaderStyle}">
        <Setter Property="Background" Value="#FFCDD2"/>
        <Setter Property="Foreground" Value="#D32F2F"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ReadOnlyColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource FilterableColumnHeaderStyle}">
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="Foreground" Value="#757575"/>
    </Style>

    <!-- Default Read-Only Cell Style -->
    <Style x:Key="DefaultReadOnlyColumnStyle" TargetType="DataGridCell">
        <!-- This style intentionally has no setters - cells look normal -->
    </Style>

    <!-- DataGrid control style -->
    <Style TargetType="{x:Type local:DynamicDataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="True"/>
    </Style>

    <!-- Column Header Context Menu Style -->
    <Style x:Key="ColumnHeaderContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column Header Menu Item Style -->
    <Style x:Key="ColumnHeaderMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="Black"/>
        <!-- Default black text -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
            <!-- Red styling for Remove items -->
            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                               Converter={StaticResource StringContainsConverter}, 
                               ConverterParameter='Remove'}" Value="True">
                <Setter Property="Foreground" Value="#F44336"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <!-- Filter items stay black (no special trigger needed since black is default) -->
        </Style.Triggers>
    </Style>
    
    <!-- Column Header Separator Style -->
    <Style x:Key="ColumnHeaderSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>
    
    <!-- Row Context Menu Style -->
    <Style x:Key="BulkSelectionContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CCCCCC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Item Styles for bulk operations -->
    <Style x:Key="BulkOperationMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#2196F3"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>

            <!-- Different styling for different operation types -->
            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                                   Converter={StaticResource StringContainsConverter}, 
                                   ConverterParameter='Check Selected'}" Value="True">
                <Setter Property="Foreground" Value="#4CAF50"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource Self}, 
                                   Converter={StaticResource StringContainsConverter}, 
                                   ConverterParameter='Uncheck Selected'}" Value="True">
                <Setter Property="Foreground" Value="#F44336"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Separator style -->
    <Style x:Key="BulkOperationSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="#E0E0E0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,2"/>
    </Style>

</ResourceDictionary>