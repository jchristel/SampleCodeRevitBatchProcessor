<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>duHastNet.PushIt</RootNamespace>
    <AssemblyName>PushIt.25.0.1.0</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Match your build script's expected path -->
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Handle Revit API version conflicts -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    
    <!-- Assembly metadata (optional - customize as needed) -->
    <AssemblyVersion>25.0.1.0</AssemblyVersion>
    <FileVersion>25.0.1.0</FileVersion>
    <Product>duHastNet</Product>
    <Company>duHast</Company>
    <!-- Copy dependencies to output -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Revit.Async" Version="2.1.1" />
    <PackageReference Include="System.Collections.Immutable" Version="9.0.6" />
    <PackageReference Include="System.Reflection.Metadata" Version="9.0.6" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitUtils.25.0.1.0">
      <HintPath>..\\..\\_References\\duHast\\RevitUtils.25.0.1.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Utils.25.0.1.0">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.1.0.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="duHastUICustomControls.25.0.1.0">
      <HintPath>..\\..\\_References\\duHast\\duHastUICustomControls.25.0.1.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FileIOWrapper.25.0.1.0">
      <HintPath>..\\..\\_References\\duHast\\FileIOWrapper.25.0.1.0.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Include content files with proper copy behavior -->
  <ItemGroup>
    <Content Include="duHast.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="PushItPlugin.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>