<Window x:Class="duHastNet.DocManager.Revit.Views.UpdateExistingDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vms="clr-namespace:duHastNet.DocManager.Revit.ViewModels"
        mc:Ignorable="d"
        Title="Update Existing Documents"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Height="560"
        Width="1000"
        MinHeight="400"
        MinWidth="700"
        d:DataContext="{d:DesignInstance Type=vms:UpdateExistingDocumentViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <!-- Row style: tint background red when the assignment is a duplicate -->
        <Style x:Key="AssignmentRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicateAssignment}" Value="True">
                    <Setter Property="Background" Value="#FFDDDD"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status text: red for any validation problem -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicateAssignment}" Value="True">
                    <Setter Property="Foreground" Value="#CC0000"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                    <Setter Property="Foreground" Value="#CC0000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ValidationSummary text style -->
        <Style x:Key="ValidationSummaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanConfirm}" Value="False">
                    <Setter Property="Foreground" Value="#CC0000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Subtitle -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Validation summary + buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="15,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Document Manager"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Assign each sheet to an existing database document whose number has changed."
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- ══ Subtitle / instruction ══ -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="3">
            <TextBlock FontSize="12">
                <Run Text="Select the existing database document that corresponds to each Revit sheet."/>
                <LineBreak/>
                <Run Text="The selected document's number and name will be updated to match the sheet. All other data (revisions, custom properties) is preserved."
                     Foreground="#555555"/>
            </TextBlock>
        </Border>

        <!-- ══ DataGrid ══ -->
        <DataGrid x:Name="AssignmentDataGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="LightGray"
                  AlternatingRowBackground="#F9F9F9"
                  RowBackground="White"
                  RowHeight="32"
                  HeadersVisibility="Column"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  FontSize="12"
                  RowStyle="{StaticResource AssignmentRowStyle}">

            <DataGrid.Columns>

                <!-- Sheet Number -->
                <DataGridTextColumn Header="Sheet Number"
                                    Binding="{Binding SheetNumber}"
                                    Width="120"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Sheet Name -->
                <DataGridTextColumn Header="Sheet Name"
                                    Binding="{Binding SheetName}"
                                    Width="*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- New Document Number (built) -->
                <DataGridTextColumn Header="New Doc Number"
                                    Binding="{Binding BuiltDocumentNumber}"
                                    Width="140"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- New Document Name (built) -->
                <DataGridTextColumn Header="New Doc Name"
                                    Binding="{Binding BuiltDocumentName}"
                                    Width="*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Current Revision -->
                <DataGridTextColumn Header="Current Rev."
                                    Binding="{Binding CurrentRevision}"
                                    Width="90"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Existing Document selection ComboBox -->
                <DataGridTemplateColumn Header="Assign to Existing Document"
                                        Width="220"
                                        IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableDocuments}"
                                      SelectedItem="{Binding SelectedDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      Margin="2,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="#555555"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Per-row validation status -->
                <DataGridTemplateColumn Header="Status"
                                        Width="160"
                                        IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource StatusTextStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ Validation summary + button bar ══ -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Validation summary -->
            <TextBlock Grid.Column="0"
                       Text="{Binding ValidationSummary, Mode=OneWay}"
                       Style="{StaticResource ValidationSummaryStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <!-- Buttons -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Confirm Update"
                        Command="{Binding ConfirmCommand}"
                        Width="140"
                        Height="30"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        IsDefault="True"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Width="80"
                        Height="30"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
