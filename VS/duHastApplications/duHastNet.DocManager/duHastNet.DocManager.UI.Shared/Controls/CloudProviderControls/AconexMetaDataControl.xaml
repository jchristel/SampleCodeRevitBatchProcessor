<UserControl x:Class="duHastNet.DocManager.UI.Shared.Controls.CloudProviderControls.AconexMetadataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Controls.CloudProviderControls"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.0"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:ValidationErrorConverter x:Key="ValidationErrorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Template file path -->
            <RowDefinition Height="Auto" />
            <!-- Phase 2: Metadata mappings ListView will go here -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Template Meta Data File Path Row -->
        <Grid Grid.Row="0" Margin="0,5,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Label -->
                <ColumnDefinition Width="*" />
                <!-- TextBox -->
                <ColumnDefinition Width="Auto" />
                <!-- Buttons -->
            </Grid.ColumnDefinitions>

            <!-- Label -->
            <Label Grid.Column="0" 
           Content="Template File:" 
           VerticalAlignment="Center"/>

            <!-- File Path TextBox -->
            <TextBox Grid.Column="1" 
             Text="{Binding TemplateMetaDataFilePath, UpdateSourceTrigger=PropertyChanged}"
             Margin="5,0,5,0"
             VerticalAlignment="Center"/>

            <!-- Button Panel -->
            <StackPanel Grid.Column="2" 
                Orientation="Horizontal" 
                VerticalAlignment="Center">

                <!-- Browse Button -->
                <Button Content="Browse..." 
                Command="{Binding BrowseTemplateFileCommand}"
                IsEnabled="{Binding IsBrowseTemplateFileEnabled}"
                MinWidth="75"
                ToolTip="Select a CSV metadata template file"/>

                <!-- Refresh Button (NEW) -->
                <Button Content="Refresh" 
                Command="{Binding RefreshTemplateCommand}"
                IsEnabled="{Binding IsRefreshTemplateEnabled}"
                Margin="5,0,0,0"
                MinWidth="75"
                ToolTip="Refresh column headers from template file"
                AutomationProperties.Name="Refresh Template Headers"/>
            </StackPanel>
        </Grid>
        <!-- Phase 2: Metadata Mappings Section -->

        <Grid Grid.Row="1" Margin="5 10 5 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Metadata Field Mappings:" 
                       FontWeight="SemiBold"
                       Margin="0 0 0 5"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" 
                          ItemsSource="{Binding MetaDataMappings}"
                          SelectedItem="{Binding SelectedMapping}"
                          SelectionMode="Single"
                          MinHeight="150">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Meta Field" 
                                            DisplayMemberBinding="{Binding MetaFieldName}" 
                                            Width="150"/>
                            <GridViewColumn Header="Value/Property" 
                                            DisplayMemberBinding="{Binding ValueOrProperty}" 
                                            Width="200"/>
                            <GridViewColumn Header="Type" 
                                            DisplayMemberBinding="{Binding MappingType}" 
                                            Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Column="1" 
                            Margin="10 0 0 0" 
                            VerticalAlignment="Top">
                    <Button Content="Add" Width="100" Padding="5" Margin="0 0 0 5"
                            Command="{Binding AddMetadataMappingCommand}"/>
                    <Button Content="Edit" Width="100" Padding="5" Margin="0 0 0 5"
                            Command="{Binding EditMetadataMappingCommand}"/>
                    <Button Content="Remove" Width="100" Padding="5"
                            Command="{Binding RemoveMetadataMappingCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
