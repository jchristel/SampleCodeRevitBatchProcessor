<Window x:Class="ThreeWaySwitchTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeWaySwitchTest"
        xmlns:custom="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.0.1"
        xmlns:tws="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls.25.0.0.1"
        xmlns:vms="clr-namespace:duHastNet.UI.ThreeWaySwitchTest.ViewModels"
        xmlns:converters="clr-namespace:duHastNet.UI.CustomControls.Converters;assembly=duHastUICustomControls.25.0.0.1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/duHastUICustomControls.25.0.0.1;component/ThreeWaySwitch/ThreeWaySwitchStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- three way switch -->
            <RowDefinition Height="auto"/>
            <!-- custom data grid -->
            <RowDefinition Height="auto"/>
            <!-- column management -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <tws:ThreeWaySwitch 
            Grid.Row="0"
            Width="Auto" 
            Height="Auto"
            Margin="10 2 10 2"
            LabelLeft="Push It" LabelCenter="Split It" LabelRight="New Room" DisplayName="Mode" />
    </Grid>
</Window>