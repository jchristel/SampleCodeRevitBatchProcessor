<UserControl x:Class="duHastNet.DocManager.Revit.Views.RevitIntegrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:duHastNet.DocManager.Revit.Views"
             xmlns:vms="clr-namespace:duHastNet.DocManager.Revit.ViewModels"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.1"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.1"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- DataTemplates for panel switching -->
        <DataTemplate DataType="{x:Type vms:SheetsPanelViewModel}">
            <views:SheetsPanelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vms:RevisionsPanelViewModel}">
            <views:RevisionsPanelView/>
        </DataTemplate>

        <!-- Shared button style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- App name header -->
            <RowDefinition Height="Auto"/>
            <!-- Global message banner -->
            <RowDefinition Height="Auto"/>
            <!-- Database path and connection status -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation bar -->
            <RowDefinition Height="Auto"/>
            <!-- Panel content area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: App name header -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="15,10">
            <TextBlock Text="Document Manager — Revit Integration"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Row 1: Global message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- Row 2: Database path and connection status -->
        <Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="15,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Database:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding DatabasePath}"
                           VerticalAlignment="Center"
                           Foreground="#555555"/>
                <!-- Connected badge -->
                <Border Background="#4CAF50"
                        Padding="6,2"
                        CornerRadius="3"
                        Margin="12,0,0,0"
                        Visibility="{Binding IsDatabaseConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Connected"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
                <!-- Not connected badge -->
                <Border Background="#F44336"
                        Padding="6,2"
                        CornerRadius="3"
                        Margin="12,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Not Connected"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Row 3: Navigation bar -->
        <Border Grid.Row="3"
                Background="#F5F5F5"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="15,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding NavigationButtonLabel}"
                        Command="{Binding NavigatePanelCommand}"
                        Style="{StaticResource NavButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Row 4: Panel content area -->
        <ContentControl Grid.Row="4"
                        Content="{Binding CurrentPanelViewModel}"/>
    </Grid>
</UserControl>
