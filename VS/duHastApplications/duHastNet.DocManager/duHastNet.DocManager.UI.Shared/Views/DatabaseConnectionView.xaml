<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.DatabaseConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <!-- data base path -->
            <RowDefinition Height="Auto" />
            <!-- document import export -->
            <RowDefinition Height="Auto" />
            <!-- revision import export -->
            <RowDefinition Height="Auto" />
            <!-- document custom property fields -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- data base path connecting and creating -->
        <Border Grid.Row="0" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <StackPanel >
                <!-- browse and connect to database -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0"
                Grid.Column="0"
                Margin="5 10 5 10"
                Padding="0 0 5 0"
                Text="Path to Database:" />
                    <TextBox
                x:Name="FilePathTextBox"
                Grid.Row="0"
                Grid.Column="1"
                Margin="5 10 5 10"
                Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"
                />
                    <Button 
                Grid.Row="0" 
                Grid.Column="2" 
                Padding="20 0 20 0"
                Margin="5 10 0 10" 
                Content="Browse"
                Command="{Binding BrowseDatabaseCommand}"
                IsEnabled="{Binding IsBrowseEnabled}"
                />
                    <Button 
                Grid.Row="0" 
                Grid.Column="3" 
                Padding="20 0 20 0"
                Margin="5 10 5 10" 
                Content="Connect"
                Command="{Binding ConnectDatabaseCommand}"
                IsEnabled="{Binding IsConnectDatabaseEnabled}"
                />
                </Grid>
                <!-- create database-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button 
                 Grid.Row="0" 
                 Grid.Column="0" 
                 Padding="20 0 20 0"
                 Margin="5 10 5 10" 
                 Content="Create Database"
                Command="{Binding CreateDatabaseCommand}"
                IsEnabled="{Binding IsCreateDatabaseEnabled}"
                 />
                </Grid>
            </StackPanel>
        </Border>
        <!-- document import and export -->
        <Border Grid.Row="1" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
            Margin="5 10 5 10" 
            Content="Import Documents"
            Command="{Binding ImportDocumentsCommand}"
            IsEnabled="{Binding IsImportExportEnabled}"
        />
                <Button Grid.Column="1"
            Margin="0 10 5 10" 
            Content="Export Documents"
            Command="{Binding ExportDocumentsCommand}"
            IsEnabled="{Binding IsImportExportEnabled}"
        />
            </Grid>
        </Border>
        <!-- revision import and export -->
        <Border Grid.Row="2" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
            Margin="5 10 5 10" 
            Content="Import Revisions"
            Command="{Binding ImportRevisionsCommand}"
            IsEnabled="{Binding IsImportExportEnabled}"
        />
                <Button Grid.Column="1"
            Margin="0 10 5 10" 
            Content="Export Revisions"
            Command="{Binding ExportRevisionsCommand}"
            IsEnabled="{Binding IsImportExportEnabled}"
        />
            </Grid>
        </Border>
        <!-- document custom property fields -->
        <Border Grid.Row="3" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander Header="Custom Fields" 
                      Margin="5 5 5 5"
                      IsExpanded="{Binding IsCustomFieldsExpanded, Mode=OneWay}">
                <Grid Margin="5 10 5 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" 
                               Text="Custom Field Definitions:" 
                               FontWeight="SemiBold"
                               Margin="0 0 0 5"/>

                    <!-- Custom Fields ListView and Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ListView -->
                        <ListView Grid.Column="0" 
                                  x:Name="CustomFieldsListView"
                                  ItemsSource="{Binding CustomFields}"
                                  SelectedItem="{Binding SelectedCustomField}"
                                  SelectionMode="Single"
                                  MinHeight="120"
                                  MaxHeight="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Field Name" 
                                                    DisplayMemberBinding="{Binding PropertyName}" 
                                                    Width="300"/>
                                    <GridViewColumn Header="Status" 
                                                    DisplayMemberBinding="{Binding StatusDisplay}" 
                                                    Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Action Buttons (Vertical Stack) -->
                        <StackPanel Grid.Column="1" 
                                    Margin="10 0 0 0" 
                                    VerticalAlignment="Top">
                            <Button Content="Add" 
                                    Command="{Binding AddCustomFieldCommand}" 
                                    Width="120"
                                    Padding="5"
                                    Margin="0 0 0 5"
                                    ToolTip="Add a new custom field definition"/>

                            <Button Content="Remove" 
                                    Command="{Binding RemoveCustomFieldCommand}" 
                                    Width="120"
                                    Padding="5"
                                    Margin="0 0 0 5"
                                    ToolTip="Remove unsaved custom field (only for new fields not yet in database)"/>

                            <Button Content="Toggle Active" 
                                    Command="{Binding ToggleCustomFieldActiveCommand}" 
                                    Width="120"
                                    Padding="5"
                                    Margin="0 0 0 5"
                                    ToolTip="Activate or deactivate the selected custom field"/>

                            <Button Content="Update Database" 
                                    Command="{Binding UpdateDatabaseSchemaCommand}" 
                                    Width="120"
                                    Padding="5"
                                    ToolTip="Apply custom field changes to the database"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
