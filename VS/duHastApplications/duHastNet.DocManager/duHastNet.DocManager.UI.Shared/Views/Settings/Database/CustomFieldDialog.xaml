<Window x:Class="duHastNet.DocManager.UI.Shared.Views.Settings.Database.CustomFieldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
        xmlns:vm="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels.Settings.Database"
        xmlns:converters="clr-namespace:duHastNet.DocManager.UI.Shared.Converters"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="450"
        d:DataContext="{d:DesignInstance Type=vm:CustomFieldDialogViewModel}">

    <Window.Resources>
        <!-- Validation error converter -->
        <converters:ValidationErrorConverter x:Key="ValidationErrorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Field Name -->
        <StackPanel Grid.Row="0" Margin="0 0 0 20">
            <TextBlock Text="Custom Field Name:" 
                       Margin="0 0 0 5"
                       FontWeight="SemiBold"/>

            <TextBox Text="{Binding FieldName, 
                            UpdateSourceTrigger=PropertyChanged, 
                            ValidatesOnNotifyDataErrors=True}"
                     Width="400"
                     HorizontalAlignment="Left"
                     Padding="5"
                     ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"/>

            <TextBlock Text="Example: ProjectPhase, DisciplineCode, ContractorName" 
                       FontSize="10"
                       Foreground="Gray"
                       Margin="0 3 0 0"/>

            <TextBlock Text="Max 100 characters. Cannot contain quotes or semicolons." 
                       FontSize="10"
                       Foreground="Gray"
                       Margin="0 2 0 0"/>
        </StackPanel>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    Width="80"
                    Height="30"
                    Margin="0 0 10 0"
                    IsDefault="True"/>

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Height="30"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
