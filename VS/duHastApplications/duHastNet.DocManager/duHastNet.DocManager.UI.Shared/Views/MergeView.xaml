<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- future user control resources-->
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
    </UserControl.Resources>

    <!-- main grid -->
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- date selection merger-->
            <RowDefinition Height="Auto"/>
            <!-- merger button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header row content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Merger" FontSize="24"/>
            <Button  Grid.Column="1" Grid.Row="0"
                Margin="10 5 10 5"
                Padding="10 5 10 5"
                Content = "Settings" 
                Command="{Binding NavigateToSettingsCommand}"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- banner row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <local:GlobalMessageView Grid.Row="1" 
                  DataContext="{Binding MessageViewModel}"
                  Margin="0 5 0 5"/>
        </Grid>
        
            <!-- merger date picker -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
               
            <TextBlock Grid.Row="0"
                    Text="Revision Date:"
                       Padding="5"
                    Margin="10 5 5 5"/>
            <DatePicker Grid.Row="0" Grid.Column="1"
                        Padding="5"
                    Margin="5 5 5 10"/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Revision Description"
                       Padding="5"
                       Margin="5 0 5 10"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                        Padding="5"
                        Margin="5 0 5 10"/>

        </Grid>

        <!-- main buttons -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!--- merge buttons -->
            <Border Grid.Row="0" Grid.RowSpan="3" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            </Border>
            <Button  Grid.Row="1"
                Margin="5 10 5 10" 
                Content = "Merge Documents"  
                FontSize="24"/>
        </Grid>
    </Grid>
</UserControl>
