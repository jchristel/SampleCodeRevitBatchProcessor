<UserControl x:Class="duHastNet.UI.FamilyReloaderUI.Views.FamiliesSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.UI.FamilyReloaderUI.Views"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.0.3"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.0.3"
             xmlns:customControls="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls.25.0.0.3"
             xmlns:dynamicDataGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.0.3"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <StackPanel>
                            <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ItemsControl Margin="0 1 0 0" FontSize="12" ItemsSource="{TemplateBinding Validation.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent}" Foreground="Red"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--converters-->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- Header row -->
            <RowDefinition Height="Auto"/>
            <!-- message banner -->
            <RowDefinition Height="Auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- library path -->
            <RowDefinition Height="Auto"/>
            <!-- Export doc type selectot-->
            <RowDefinition Height="Auto"/>
            <!-- Export sheet buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Border 
            Grid.Row="0" 
            Background="#2196F3" 
            Padding="15,10" 
            Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Family Reloader" 
                  FontSize="20" 
                  FontWeight="Bold" 
                  Foreground="White"/>
                <TextBlock Text="Reload families en-batch into your project or family" 
                  FontSize="12" 
                  Foreground="White" 
                  Opacity="0.9"/>
            </StackPanel>
        </Border>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>
        
        <!-- Sheet selection -->
        <Grid Grid.Row="2">
            <!-- grid view -->
            <dynamicDataGrid:DynamicDataGrid  
                x:Name="dataGrid" 
                Grid.Row="0"
                Margin="5 10 5 10"
                DataContext="{Binding  FamiliesSelectionDataGridViewModel}"
                ItemsSource="{Binding Data}"
                ColumnDefinitions="{Binding ColumnDefinitions}"
                SelectionMode="Extended"
                dynamicDataGrid:DataGridColumnHeaderBehavior.EnableColumnManagement="True"
                dynamicDataGrid:DataGridColumnHeaderBehavior.EnableBulkSelection="True"
                Loaded="FamilySelectionGrid_Loaded"
                />
            
        </Grid>
        <!--Export path -->
        <Border Grid.Row="3" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                 Grid.Column="0"
                 Margin="0 10 5 10"
                 Padding="5 0 5 0"
                 Text="Library Path:" />
                <TextBox
                    x:Name="LibraryFilePathTextBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5 10 5 10"
                    Text="{Binding LibraryFilePath, 
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged,
                           ValidatesOnNotifyDataErrors=True,
                           NotifyOnValidationError=True}"/>

                <CheckBox 
                    Grid.Row="0"
                    Grid.Column="2"
                    Content="Incl Sub Directories"
                    Padding="10 0 10 0"
                    Margin="5 10 5 10" 
                    IsChecked="{Binding IncludeSubDirectoriesInSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button 
                     Grid.Row="0" 
                     Grid.Column="3" 
                     Padding="20 0 20 0"
                     Margin="5 10 5 10" 
                     Content="Browse"
                     Click="Browse_OnClick"/>
                <Button 
                     Grid.Row="0" 
                     Grid.Column="4" 
                     Padding="20 0 20 0"
                     Margin="5 10 5 10" 
                     Content="Update"
                     Command="{Binding UpdateCommand}"/>
            </Grid>
        </Border>
        <!--export format selector -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="0"
                    GroupName="ImportType"
                    Content="Import All Types On Reload"
                    IsChecked="{Binding LoadAllFamilyTypes, 
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged,
                           ValidatesOnNotifyDataErrors=True,
                           NotifyOnValidationError=True}"/>
                <RadioButton
                    Grid.Row="0"
                    Grid.Column="1"
                    GroupName="ImportType"
                    Content="Reload Existing Types Only"
                    IsChecked="{Binding UpdateExistingTypesOnly, 
                       Mode=TwoWay,
                       UpdateSourceTrigger=PropertyChanged,
                       ValidatesOnNotifyDataErrors=True,
                       NotifyOnValidationError=True}"/>
            </Grid>
        </Border>
        
        <!-- export row content -->
        <Border Grid.Row="5" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                     Margin="2 5 2 5" 
                     Content = "Reload Families"
                     Command="{Binding SaveAndCloseCommand}"
                     FontSize="24"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
