<UserControl x:Class="duHastNet.PushIt.Views.RoomsSelection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.PushIt.Views"
             xmlns:dataSourceViews="clr-namespace:duHastNet.PushIt.Views.DataSource"
             xmlns:utilsViews ="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.0"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.0"
             xmlns:pushItConverter ="clr-namespace:duHastNet.PushIt.Converters"
             xmlns:customControls="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls.25.0.1.0"
             xmlns:dynamicDataGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.1.0"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Validation error style for TextBox fields -->
        <Style TargetType="TextBox">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <AdornedElementPlaceholder/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <StackPanel>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ItemsControl Margin="0 1 0 0" FontSize="12" ItemsSource="{TemplateBinding Validation.Errors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ErrorContent}" Foreground="Red"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilterApplied}" Value="True">
                    <Setter Property="BorderBrush" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--converters-->
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <pushItConverter:CountConverter x:Key="CountConverter"/>
        <pushItConverter:EnumToBooleanConverter x:Key="ModusConverter" />
        <pushItConverter:RoomRowBackgroundConverter x:Key="RoomRowBackgroundConverter"/>
    </UserControl.Resources>

    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- data grid -->
            <RowDefinition Height="*"/>
            <!-- refresh / model status -->
            <RowDefinition Height="auto"/>
            <!-- admin expander -->
            <RowDefinition Height="auto"/>
            <!-- push it buttons -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border 
            Grid.Row="0" 
            Background="#2196F3" 
            Padding="15,10" 
            Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Push It...Real Good!" 
                        FontSize="20" 
                        FontWeight="Bold" 
                        Foreground="White"/>
                    <TextBlock Text="Rapid layout development in Revit" 
                        FontSize="12" 
                        Foreground="White" 
                        Opacity="0.9"/>
                </StackPanel>
                <TextBlock 
                    Grid.Column="1"
                    Text="{Binding RevitDocumentTitle}"
                    FontSize="20"
                    Foreground="White"
                    Opacity="0.85"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="10,0,10,0"/>
                <!-- Settings navigation button -->
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Padding="10,4"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="White"
                    BorderThickness="1"
                    FontSize="12"
                    Content="⚙ Settings"
                    Command="{Binding NavigateToSettingsCommand}"/>
            </Grid>
        </Border>

        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- rooms data grid -->
        <dynamicDataGrid:DynamicDataGrid  
            x:Name="dataGrid" 
            Grid.Row="2"
            DataContext="{Binding RoomsDataGridViewModel}"
            ItemsSource="{Binding Data}"
            ColumnDefinitions="{Binding ColumnDefinitions}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedItem}"
            Margin="5 10 5 10"
            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableColumnManagement="True"
            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableBulkSelection="False"
            IsEnabled="{Binding IsGridEnabled}"
            Loaded="RoomSelectionGrid_Loaded">
            <dynamicDataGrid:DynamicDataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Red" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Values[Count]}" Value="0">
                            <Setter Property="Background" Value="White"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Values[Count]}" Value="1">
                            <Setter Property="Background" Value="LightGray"/>
                        </DataTrigger>
                        <!-- New room rows: light green (fires after Count triggers) -->
                        <DataTrigger Value="NewRoom">
                            <DataTrigger.Binding>
                                <Binding Path="Values[Id]"
                                         Converter="{StaticResource RoomRowBackgroundConverter}"/>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#DFF0D8"/>
                        </DataTrigger>
                        <!-- Split room rows: amber (fires after new room trigger) -->
                        <DataTrigger Value="SplitRoom">
                            <DataTrigger.Binding>
                                <Binding Path="Values[Id]"
                                         Converter="{StaticResource RoomRowBackgroundConverter}"/>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="#FFF3CD"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </dynamicDataGrid:DynamicDataGrid.RowStyle>
        </dynamicDataGrid:DynamicDataGrid>

        <!-- model action buttons row -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0 5 5 5" Command="{Binding RefreshGUICommand}">
                <TextBlock Text="Refresh rooms from model" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button Grid.Column="1" Margin="0 5 5 5" Command="{Binding WipeSelectedRoomDataCommand}">
                <TextBlock Text="Wipe selected rooms in model" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button Grid.Column="2" Margin="0 5 5 5" Command="{Binding HighLightRoomCommand}">
                <TextBlock Text="Highlight rooms in model" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <TextBlock Grid.Column="3" Margin="5 5 0 5">
                <Run Text="Design Set: " />
                <Run Text="{Binding ActiveDesignSetName}" />
                <LineBreak />
                <Run Text="Design Option: " />
                <Run Text="{Binding ActiveDesignOptionName}" />
            </TextBlock>
        </Grid>

        <!-- admin expander -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Expander Header="Data Admin" Margin="5 5 5 5">
                <StackPanel>
                    <!-- Admin action buttons -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Margin="0 10 5 10"
                                Content="Update rooms in model"
                                Command="{Binding UpdateAllRoomsCommand}"/>

                        <Button Grid.Column="1" Margin="5 10 5 10"
                                Content="Wipe stale data from rooms in model"
                                Command="{Binding WipeStaleRoomsDataCommand}"/>

                        <!-- Save data — hidden TextBox stores the path (MVVM pattern) -->
                        <StackPanel Orientation="Vertical" Grid.Column="2">
                            <Button Margin="5 10 5 10"
                                    Content="Save room data"
                                    Click="SaveFile_OnClick"/>
                            <TextBox x:Name="SaveAsPathTextBox"
                                     Visibility="Collapsed"
                                     Width="200" Height="30"
                                     Text="{Binding SaveFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- push it buttons -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.RowSpan="3" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2"/>
            <customControls:ThreeWaySwitch 
                Grid.Row="0"
                Margin="10 2 10 2"
                LabelLeft="Push It" LabelCenter="Split It" LabelRight="New Room" DisplayName="Mode"
                Value="{Binding SwitchState, Mode=TwoWay}"/>
            <Button Grid.Row="1"
                    Margin="5 10 5 10"
                    Content="{Binding PushItButtonText}"
                    FontSize="24"
                    IsEnabled="{Binding IsPushEnabled}"
                    Command="{Binding PushSingleRoomCommand}"/>
        </Grid>

    </Grid>
</UserControl>
