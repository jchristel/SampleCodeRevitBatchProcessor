<Window x:Class="ThreeWaySwitchTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThreeWaySwitchTest"
        xmlns:custom="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls"
        xmlns:tws ="clr-namespace:duHastNet.UI.CustomControls;assembly=duHastUICustomControls"
        xmlns:vms ="clr-namespace:duHastNet.UI.ThreeWaySwitchTest.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.DataContext>
        <vms:DynamicDataGridViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- three way switch -->
            <RowDefinition Height="auto"/>
            <!-- custom data grid -->
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <tws:ThreeWaySwitch 
            Grid.Row="0"
            Width="Auto" 
            Height="Auto"
            Margin="10 2 10 2"
            LabelLeft="Push It" LabelCenter="Split It" LabelRight="New Room" DisplayName="Mode" />
        <custom:DynamicDataGrid Grid.Row="1"
                               ColumnDefinitions="{Binding ColumnDefinitions}"
                               ItemsSource="{Binding Data}"
                               CanUserDeleteRows="True"
                               GridLinesVisibility="All"
                               HeadersVisibility="Column"
                               SelectionMode="Single"
                               Background="White"
                               AlternatingRowBackground="LightGray"/>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="0,10,0,0">

            <Button Content="Add Row" 
                    Command="{Binding AddRowCommand}"
                    Padding="10,5" 
                    Margin="0,0,10,0"/>

            <Button Content="Reinitialize Grid" 
                    Command="{Binding InitializeGridCommand}"
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
