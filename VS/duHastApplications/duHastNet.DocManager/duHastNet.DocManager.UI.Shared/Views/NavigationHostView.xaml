<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.NavigationHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localsettings="clr-namespace:duHastNet.DocManager.UI.Shared.Views.Settings"
             xmlns:localmerge="clr-namespace:duHastNet.DocManager.UI.Shared.Views.Merge"
             xmlns:localtransmittal="clr-namespace:duHastNet.DocManager.UI.Shared.Views.Transmittal"
             xmlns:viewmodels="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels"
             xmlns:viewmodelssettings="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels.Settings"
             xmlns:viewmodelsmerge="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels.Merge"
             xmlns:viewmodelstransmittal="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels.Transmittal"
             mc:Ignorable="d" 
             Width="Auto" 
             Height="Auto"
             d:DataContext="{d:DesignInstance Type=viewmodels:NavigationHostViewModel}">
    
    <UserControl.Resources>
        <!-- DataTemplate for SettingsViewModel -->
        <DataTemplate DataType="{x:Type viewmodelssettings:SettingsViewModel}">
            <localsettings:SettingsView/>
        </DataTemplate>

        <!-- DataTemplate for MergeViewModel -->
        <DataTemplate DataType="{x:Type viewmodelsmerge:MergeViewModel}">
            <localmerge:MergeView/>
        </DataTemplate>

        <!-- DataTemplate for TransmittalViewModel -->
        <DataTemplate DataType="{x:Type viewmodelstransmittal:TransmittalViewModel}">
            <localtransmittal:TransmittalView/>
        </DataTemplate>

        <!-- Add more DataTemplates here for other ViewModels as needed -->
    </UserControl.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>
</UserControl>
