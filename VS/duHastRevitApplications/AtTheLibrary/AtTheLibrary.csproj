<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>duHastNet.AtTheLibrary</RootNamespace>
    <AssemblyName>AtTheLibrary</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Handle Revit API version conflicts -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Revit.Async" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitUtils.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\RevitUtils.25.0.0.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Utils.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.0.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>