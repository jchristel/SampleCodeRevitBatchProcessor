<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.Transmittal.TransmittalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.1"
             xmlns:customGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.1.1"
             xmlns:viewmodels="clr-namespace:duHastNet.DocManager.UI.Shared.ViewModels.Transmittal"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:TransmittalViewModel}">

    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <!-- header banner -->
            <RowDefinition Height="Auto"/>
            <!-- global message banner -->
            <RowDefinition Height="Auto"/>
            <!-- revisions section -->
            <RowDefinition Height="2*"/>
            <!-- documents section -->
            <RowDefinition Height="3*"/>
            <!-- action bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Row 0 — Header Banner                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#2196F3"
                Padding="15,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Document Manager"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Transmittal — Revision History"
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Row 1 — Global Message Banner                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Row 2 — Revisions Section                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Revisions"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="8,6,8,4"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding RevisionsStatusMessage}"
                           FontSize="12"
                           Foreground="#555555"
                           Margin="8,4,8,4"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <customGrid:DynamicDataGrid
                    Grid.Row="2"
                    Margin="8,0,8,8"
                    ItemsSource="{Binding RevisionRows}"
                    ColumnDefinitions="{Binding RevisionColumnDefinitions}"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="Horizontal"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Row 3 — Documents Section                               -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- section header + mode toggle -->
                    <RowDefinition Height="Auto"/>
                    <!-- options row -->
                    <RowDefinition Height="Auto"/>
                    <!-- status message -->
                    <RowDefinition Height="Auto"/>
                    <!-- documents datagrid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- section header + mode toggle (toggle binding added in Step 2) -->
                <Grid Grid.Row="0" Margin="8,6,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Documents"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <!-- mode toggle -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton Content="Show All"
                                     GroupName="DocumentMode"
                                     IsChecked="{Binding IsShowAllMode, Mode=TwoWay}"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"/>
                        <RadioButton Content="By Revisions Only"
                                     GroupName="DocumentMode"
                                     IsChecked="{Binding IsByRevisionMode, Mode=TwoWay}"
                                     VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- options row -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="8,0,8,6">
                    <CheckBox Content="Show inactive documents"
                              IsChecked="{Binding ShowInactiveDocuments, Mode=TwoWay}"
                              Margin="0,0,20,0"
                              VerticalContentAlignment="Center"/>
                    <CheckBox Content="Include document history"
                              IsChecked="{Binding IncludeDocumentHistory, Mode=TwoWay}"
                              VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- status message -->
                <TextBlock Grid.Row="2"
                           Text="{Binding DocumentsStatusMessage}"
                           FontSize="12"
                           Foreground="#555555"
                           Margin="8,0,8,4"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- documents DynamicDataGrid -->
                <customGrid:DynamicDataGrid
                    Grid.Row="3"
                    Margin="8,0,8,8"
                    ItemsSource="{Binding DocumentRows}"
                    ColumnDefinitions="{Binding DocumentColumnDefinitions}"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    GridLinesVisibility="Horizontal"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <customGrid:DynamicDataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding [IsInactive]}" Value="True">
                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </customGrid:DynamicDataGrid.RowStyle>
                </customGrid:DynamicDataGrid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Row 4 — Action Bar                                      -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="#F5F5F5"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ExportStatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#555555"/>

                <Button Grid.Column="1"
                        Content="Export to CSV"
                        Command="{Binding ExportToCsvCommand}"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#2196F3"
                        BorderThickness="0"
                        Padding="14,7"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="Close"
                        Command="{Binding CloseCommand}"
                        Padding="14,7"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
