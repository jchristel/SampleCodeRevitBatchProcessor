<UserControl x:Class="duHastNet.PushIt.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dataSourceViews="clr-namespace:duHastNet.PushIt.Views.DataSource"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.2"
             xmlns:dynamicDataGrid="clr-namespace:duHastNet.UI.CustomControls.CustomDataGrid;assembly=duHastUICustomControls.25.0.1.2"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Message banner -->
            <RowDefinition Height="Auto"/>
            <!-- Settings content -->
            <RowDefinition Height="*"/>
            <!-- Bottom buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border
            Grid.Row="0"
            Background="#2196F3"
            Padding="15,10"
            Margin="0,0,0,10">
            <TextBlock
                Text="Settings"
                FontSize="20"
                FontWeight="Bold"
                Foreground="White"/>
        </Border>

        <!-- Message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>

        <!-- Settings content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0 5 0 5">

                <!-- Data Source section -->
                <Border CornerRadius="3" BorderBrush="Gray" BorderThickness="1" Margin="0 5 0 5" Padding="10">
                    <StackPanel>
                        <TextBlock
                            Text="Data Source"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Margin="0 0 0 8"/>
                        <dataSourceViews:DataSourceControl
                            DataContext="{Binding DataSourceViewModel}"/>
                    </StackPanel>
                </Border>

                <!-- Supported Categories section -->
                <Border CornerRadius="3" BorderBrush="Gray" BorderThickness="1" Margin="0 5 0 5" Padding="10">
                    <StackPanel>
                        <TextBlock
                            Text="Supported Categories"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Margin="0 0 0 8"/>
                        <dynamicDataGrid:DynamicDataGrid
                            x:Name="dataGridSupportedCategories"
                            DataContext="{Binding SupportedCategoriesDataGridViewModel}"
                            ItemsSource="{Binding Data}"
                            ColumnDefinitions="{Binding ColumnDefinitions}"
                            SelectionMode="Extended"
                            Margin="0 5 0 5"
                            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableColumnManagement="False"
                            dynamicDataGrid:DataGridColumnHeaderBehavior.EnableBulkSelection="True"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action buttons -->
        <Border
            Grid.Row="3"
            BorderBrush="LightGray"
            BorderThickness="0,1,0,0"
            Padding="0,10,0,0"
            Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Content="Cancel"
                    Padding="24,6"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>

                <Button
                    Grid.Column="2"
                    Content="Load Data"
                    Padding="24,6"
                    Background="#2196F3"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Command="{Binding LoadDataCommand}"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
