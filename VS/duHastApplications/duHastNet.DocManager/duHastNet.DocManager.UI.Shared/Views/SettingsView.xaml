<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- future user control resources-->
    <UserControl.Resources>
        <!-- a style for the text box if it contains a validation error-->
    </UserControl.Resources>

    <!-- main grid -->
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- header row -->
            <RowDefinition Height="auto"/>
            <!-- message banner -->
            <RowDefinition Height="auto"/>
            <!-- settings current documents -->
            <RowDefinition Height="auto"/>
            <!-- settings aconex -->
            <RowDefinition Height="auto"/>
            <!-- settings database -->
            <RowDefinition Height="auto"/>
            <!-- buttons -->
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- header row content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- header row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="Settings" FontSize="24"/>
        </Grid>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <!-- banner row -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <local:GlobalMessageView Grid.Row="1" 
                              DataContext="{Binding MessageViewModel}"
                              Margin="0 5 0 5"/>
        </Grid>
        
        <!-- current documents management expander -->
        <Border Grid.Row="2" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Current Documents" Margin="5 5 5 5">
                <local:CurrentFolderView
                  DataContext="{Binding CurrentFolderViewModel}"
                  Margin="0 5 0 5"/>
            </Expander>
        </Border>
        <!-- cloud document manager management expander -->
        <Border Grid.Row="3" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Cloud Document Manager" Margin="5 5 5 5">
                <local:CloudDocumentManagerView 
                  DataContext="{Binding AconexMetadataViewModel}"
                  Margin="0 5 0 5"/>
            </Expander>
        </Border>
        <!-- database management expander -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray"  BorderThickness="1" Margin="0 2 0 2">
            <Expander  Header="Database" Margin="5 5 5 5">
                <Grid>
                    <local:DatabaseConnectionView
                      DataContext="{Binding DatabaseConnectionViewModel}"
                      Margin="0 5 0 5"/>
                </Grid>
            </Expander>
        </Border>
        <!-- main buttons -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--- merge buttons -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            </Border>
            <Button  
                Grid.Row="0"
                Grid.Column="0"
                Margin="5 10 5 10" 
                Content = "Close"  
                FontSize="24" Command="{Binding NavigateToMergeCommand}"/>
            <Button  
                Grid.Row="0"
                Grid.Column="1"
                Margin="5 10 5 10" 
                Content = "Save"  
                FontSize="24" Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</UserControl>
