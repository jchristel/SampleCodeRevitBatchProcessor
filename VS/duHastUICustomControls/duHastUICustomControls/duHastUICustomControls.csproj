<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>duHastNet.UI.CustomControls</RootNamespace>
    <AssemblyName>duHastUICustomControls.25.0.0.1</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Match your build script's expected path -->
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <!-- Disable automatic framework folder -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Reference to your converted Utils library -->
  <ItemGroup>
    <Reference Include="Utils.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.0.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>