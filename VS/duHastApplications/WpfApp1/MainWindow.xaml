<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <UniformGrid Columns="3" Grid.Row="1">
                <RadioButton Margin="5 0 5 0" Content="Push It" GroupName="MyGroup" IsChecked="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <RadioButton Margin="5 0 5 0" Content="Split It" GroupName="MyGroup" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <RadioButton Margin="5 0 5 0" Content="Create It" GroupName="MyGroup" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
