<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>duHastNet.UI.PDFDWGExporterSelectionUI</RootNamespace>
    <AssemblyName>PDFDWGExporterSelectionUI.25.0.0.1</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Match your build script's expected path -->
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Assembly metadata (optional - customize as needed) -->
    <AssemblyVersion>25.0.0.1</AssemblyVersion>
    <FileVersion>25.0.0.1</FileVersion>
    <AssemblyTitle>duHast UI Custom Controls</AssemblyTitle>
    <Product>duHast</Product>
    <Company>Your Company</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDFDWGExporterUI\PDFDWGExporterUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Utils.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.0.1.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="duHastUICustomControls.25.0.0.1">
      <HintPath>..\\..\\_References\\duHast\\duHastUICustomControls.25.0.0.1.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
    
</Project>