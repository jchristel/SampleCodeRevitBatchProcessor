<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.Settings.CurrentFolder.CurrentFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Views"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.1"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:ValidationErrorConverter x:Key="ValidationErrorConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- revision prefix suffix-->
            <RowDefinition Height="Auto" />
            <!-- incoming folder path -->
            <RowDefinition Height="Auto" />
            <!-- archive folder path -->
            <RowDefinition Height="Auto" />
            <!-- current folder system-->
            <RowDefinition Height="Auto" />
            <!-- supported file types -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- revision prefix suffix-->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                    Margin="5 10 5 10"
                    Padding="5"
                    Text="Revision Prefix:" />
            <TextBox Grid.Column="1"
                    x:Name="RevisionPrefixTextBox"
                    Margin="5 10 5 10"
                    Text="{Binding RevisionPrefix, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"
                />
            <TextBlock Grid.Column="2"
                    Margin="15 10 5 10"
                    Padding="5"
                    Text="Revision Suffix:" />
            <TextBox Grid.Column="3"
                    x:Name="RevisionSuffixTextBox"
                    Margin="5 10 5 10"
                    Text="{Binding RevisionSuffix, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"
                />
            
        </Grid>

        <!-- incoming folder path -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                    Margin="5 10 5 10"
                    Padding="5"
                    Text="Incoming Folder Path:" />
            <TextBox Grid.Column="1"
                    x:Name="IncomingFolderPathTextBox"
                    Margin="5 10 5 10"
                    Text="{Binding IncomingFolderPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"
                />
            <Button Grid.Column="2"
                    Margin="5 10 5 10"
                    Padding="5"
                    Content="Browse"
                    Command="{Binding BrowseIncomingFolderCommand}"
                    IsEnabled="{Binding IsBrowseIncomingFolderEnabled}"
                />
        </Grid>

        <!-- archive folder path -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
                <TextBlock Grid.Column="0"
                    Margin="5 10 5 10"
                    Padding="5"
                    Text="Archive Folder Path:" />
            <TextBox Grid.Column="1"
                    x:Name="ArchiveFolderPathTextBox"
                    Margin="5 10 5 10"
                    Text="{Binding ArchiveFolderPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}"
                />
            <Button Grid.Column="2"
                    Margin="5 10 5 10"
                    Padding="5"
                    Content="Browse"
                    Command="{Binding BrowseArchiveFolderCommand}"
                    IsEnabled="{Binding IsBrowseArchiveFolderEnabled}"
                />
        </Grid>

        <!-- filing rules -->
        <Grid Grid.Row="3" Margin="5 10 5 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Section Header -->
            <TextBlock Grid.Row="0" 
                       Text="Filing Rules (evaluated top to bottom, first match wins):" 
                       FontWeight="SemiBold"
                       Margin="0 0 0 5"/>

            <!-- Rules ListView and Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ListView -->
                <ListView Grid.Column="0" 
                          x:Name="FilingRulesListView"
                          ItemsSource="{Binding FilingRules}"
                          SelectedItem="{Binding SelectedFilingRule}"
                          SelectionMode="Single"
                          MinHeight="150">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Filter Type" 
                                            DisplayMemberBinding="{Binding RuleType}" 
                                            Width="150"/>
                            <GridViewColumn Header="Filter Value" 
                                            DisplayMemberBinding="{Binding FilterValue}" 
                                            Width="150"/>
                            <GridViewColumn Header="Target Path" 
                                            DisplayMemberBinding="{Binding TargetPath}" 
                                            Width="350"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Highlight default row with different background or bold font -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="ToolTip" Value="Default is a required file type and cannot be removed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Action Buttons (Vertical Stack) -->
                <StackPanel Grid.Column="1" 
                            Margin="10 0 0 0" 
                            VerticalAlignment="Top">
                    <Button Content="Add" 
                            Command="{Binding AddFilingRuleCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Add a new filing rule"/>

                    <Button Content="Edit" 
                            Command="{Binding EditFilingRuleCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Edit the selected filing rule"/>

                    <Button Content="Remove" 
                            Command="{Binding RemoveFilingRuleCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Remove the selected filing rule (cannot remove CatchAll)"/>

                    <Button Content="Move Up" 
                            Command="{Binding MoveRuleUpCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Move the selected rule up (higher priority)"/>

                    <Button Content="Move Down" 
                            Command="{Binding MoveRuleDownCommand}" 
                            Width="100"
                            Padding="5"
                            ToolTip="Move the selected rule down (lower priority)"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- supported file types -->
        <Grid Grid.Row="4" Margin="5 10 5 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Section Header -->
            <TextBlock Grid.Row="0" 
                       Text="Supported File Types:" 
                       FontWeight="SemiBold"
                       Margin="0 0 0 5"/>

            <!-- File Types ListView and Buttons -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ListView -->
                <ListView Grid.Column="0" 
                          x:Name="SupportedFileTypesListView"
                          ItemsSource="{Binding SupportedFileTypes}"
                          SelectedItem="{Binding SelectedFileType}"
                          SelectionMode="Single"
                          MinHeight="120"
                          MaxHeight="200">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File Extension" 
                                            DisplayMemberBinding="{Binding FileExtension}" 
                                            Width="120"/>
                            <GridViewColumn Header="Description" 
                                            DisplayMemberBinding="{Binding Description}" 
                                            Width="200"/>
                            <GridViewColumn Header="Number Modifier" 
                                            DisplayMemberBinding="{Binding ModifierDisplay}" 
                                            Width="280"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Highlight PDF row with different background or bold font -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPdf}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="ToolTip" Value="PDF is a required file type and cannot be removed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Action Buttons (Vertical Stack) -->
                <StackPanel Grid.Column="1" 
                            Margin="10 0 0 0" 
                            VerticalAlignment="Top">
                    <Button Content="Add" 
                            Command="{Binding AddFileTypeCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Add a new supported file type"/>

                    <Button Content="Edit" 
                            Command="{Binding EditFileTypeCommand}" 
                            Width="100"
                            Padding="5"
                            Margin="0 0 0 5"
                            ToolTip="Edit the selected file type"/>

                    <Button Content="Remove" 
                            Command="{Binding RemoveFileTypeCommand}" 
                            Width="100"
                            Padding="5"
                            ToolTip="Remove the selected file type (cannot remove PDF)"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
