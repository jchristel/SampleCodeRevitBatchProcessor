<UserControl x:Class="duHastNet.DocManager.UI.Shared.Controls.CloudProviderControls.AconexMetadataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.UI.Shared.Controls.CloudProviderControls"
             xmlns:converters="clr-namespace:duHastNet.DocManager.UI.Shared.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:ValidationErrorConverter x:Key="ValidationErrorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Template file path -->
            <RowDefinition Height="Auto" />
            <!-- Phase 2: Metadata mappings ListView will go here -->
            <!-- <RowDefinition Height="Auto" /> -->
        </Grid.RowDefinitions>

        <!-- Template Meta Data File Path -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="5 10 5 10"
                       Padding="5"
                       Text="Template Meta Data File Path:" />

            <TextBox Grid.Column="1"
                     x:Name="TemplateMetaDataFilePathTextBox"
                     Margin="5 10 5 10"
                     Padding="5"
                     Text="{Binding TemplateMetaDataFilePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                     ToolTip="{Binding (Validation.Errors), RelativeSource={RelativeSource Self}, Converter={StaticResource ValidationErrorConverter}}" />

            <Button Grid.Column="2"
                    Margin="5 10 5 10"
                    Padding="5"
                    Content="Browse"
                    Command="{Binding BrowseTemplateFileCommand}"
                    IsEnabled="{Binding IsBrowseTemplateFileEnabled}" />
        </Grid>

        <!-- Phase 2: Metadata Mappings Section -->
        <!-- This will be added in Phase 2 following the pattern from CurrentFolderView's Filing Rules section -->
        <!--
