<UserControl x:Class="duHastNet.DocManager.UI.Shared.Views.GlobalMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Error Message Style -->
        <Style x:Key="ErrorMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#F44336"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Information Message Style -->
        <Style x:Key="InfoMessageStyle" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <!-- Message Banner -->
    <Border x:Name="MessageBorder" 
            Padding="12 8"
            CornerRadius="4"
            Margin="0 0 0 8"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibilityConverter}}"
            MouseEnter="MessageBorder_MouseEnter"
            MouseLeave="MessageBorder_MouseLeave">

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                        <Setter Property="Background" Value="#FFEBEE"/>
                        <Setter Property="BorderBrush" Value="#F44336"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsInformationMessage}" Value="True">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="BorderBrush" Value="#2196F3"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Message Text with Close Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#212121"/>

                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding ClearMessageCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8 4"
                        FontSize="16"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        ToolTip="Dismiss message"/>
            </Grid>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1"
                         Height="3"
                         Margin="0 8 0 0"
                         Value="{Binding ProgressPercentage, Mode=OneWay}"
                         Minimum="0"
                         Maximum="100"
                         Visibility="{Binding IsTimerActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                <Setter Property="Foreground" Value="#F44336"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInformationMessage}" Value="True">
                                <Setter Property="Foreground" Value="#2196F3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>
    </Border>
</UserControl>