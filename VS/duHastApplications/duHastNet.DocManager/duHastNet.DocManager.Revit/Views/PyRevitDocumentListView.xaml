<UserControl x:Class="duHastNet.DocManager.Revit.Views.PyRevitDocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.DocManager.Revit.Views"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.1"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Style for status text -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        
        <!-- Style for buttons -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Padding="15,10" 
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Document Manager - PyRevit Integration" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock Text="Proof of Concept: Display Documents from Database" 
                          FontSize="12" 
                          Foreground="White" 
                          Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- Database Info and Controls -->
        <Border Grid.Row="1" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Database Path -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Database Path:" 
                              FontWeight="SemiBold" 
                              VerticalAlignment="Center" 
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DatabasePath}" 
                              VerticalAlignment="Center" 
                              Foreground="#666666"/>
                    <Border Background="#4CAF50" 
                           Padding="5,2" 
                           CornerRadius="3" 
                           Margin="10,0,0,0"
                           Visibility="{Binding IsDatabaseConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Connected" 
                                  Foreground="White" 
                                  FontSize="10" 
                                  FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="Load Documents" 
                           Command="{Binding LoadDocumentsCommand}"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Refresh" 
                           Command="{Binding RefreshCommand}"
                           Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="Close Connection" 
                           Command="{Binding CloseCommand}"
                           Style="{StaticResource ActionButtonStyle}"/>
                    
                    <!-- Loading Indicator -->
                    <StackPanel Orientation="Horizontal" 
                               Margin="20,0,0,0"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⏳" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Loading..." 
                                  VerticalAlignment="Center" 
                                  Style="{StaticResource StatusTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document Grid -->
        <Border Grid.Row="2" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1">
            <DataGrid ItemsSource="{Binding Documents}" 
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                       Binding="{Binding Id}" 
                                       Width="60"/>
                    <DataGridTextColumn Header="Number" 
                                       Binding="{Binding Number}" 
                                       Width="150"/>
                    <DataGridTextColumn Header="Name" 
                                       Binding="{Binding Name}" 
                                       Width="*"/>
                    <DataGridTextColumn Header="Revision" 
                                       Binding="{Binding Revision}" 
                                       Width="80"/>
                    <DataGridTextColumn Header="Revision ID" 
                                       Binding="{Binding RevisionId}" 
                                       Width="100"/>
                    <DataGridTextColumn Header="Status" 
                                       Binding="{Binding Status}" 
                                       Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="#F5F5F5" 
                BorderBrush="#CCCCCC" 
                BorderThickness="0,1,0,0" 
                Padding="10,5" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}" 
                          VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" 
                          VerticalAlignment="Center"
                          FontWeight="SemiBold">
                    <Run Text="Total Documents: "/>
                    <Run Text="{Binding TotalDocuments}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
