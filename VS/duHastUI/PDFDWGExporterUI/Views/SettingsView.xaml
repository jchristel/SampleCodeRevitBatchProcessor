<UserControl x:Class="duHastNet.UI.PDFDWGExporterUI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:duHastNet.UI.PDFDWGExporterUI.Views"
             xmlns:utilsViews="clr-namespace:duHastNet.Utils.WPF.Views;assembly=Utils.25.0.1.0"
             xmlns:converters="clr-namespace:duHastNet.Utils.WPF.Converters;assembly=Utils.25.0.1.0"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--converters-->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="10 10 10 10">
        <Grid.RowDefinitions>
            <!-- Header row -->
            <RowDefinition Height="Auto"/>
            <!-- message banner -->
            <RowDefinition Height="Auto"/>
            <!-- document type selector -->
            <RowDefinition Height="auto"/>
            <!-- data -->
            <RowDefinition Height="*"/>
            <!-- buttons export import-->
            <RowDefinition Height="Auto"/>
            <!-- buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- header row content -->
        <Border 
            Grid.Row="0" 
            Background="#2196F3" 
            Padding="15,10" 
            Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Export PDF's and DWG's" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Foreground="White"/>
                <TextBlock Text="Settings" 
                    FontSize="12" 
                    Foreground="White" 
                    Opacity="0.9"/>
            </StackPanel>
        </Border>
        <!-- message banner -->
        <Grid Grid.Row="1">
            <utilsViews:GlobalMessageView DataContext="{Binding GlobalMessageViewModel}"/>
        </Grid>
        <!-- filter -->
        <Border Grid.Row="2" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Margin="5 5 5 5"
                    Text="Select Document Type" />

                <StackPanel Grid.Row="1">
                    <!-- document type selection ComboBox -->
                    <ComboBox
                        Grid.Column="0"
                        Margin="5 5 5 5" 
                        ItemsSource="{Binding DocumentTypeNameDefaultList}"
                        SelectedValue="{Binding Path=SelectedDocumentType,Mode=TwoWay}"/>
                    <TextBlock 
                        Margin="5 5 5 5"
                        Text="DWG Export Scheme" 
                        Visibility="{Binding IsDWGExportSchemeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <!-- DWG export scheme ComboBox (Visibility controlled by SelectedOption) -->
                    <ComboBox Margin="5 5 5 5"
                         ItemsSource="{Binding  DWGExportSchemeNameList}"   
                         Visibility="{Binding IsDWGExportSchemeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                         SelectedValue="{Binding Path=SelectedDWGExportSchemeName,Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- grid view -->
        <Border Grid.Row="3" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">

            <Grid Margin="5 5 5 5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- parameter grid -->
                <DataGrid Grid.Row="0" Grid.Column="0" x:Name="dataGridParameters" 
                    ItemsSource="{Binding DataViewAvailableParameters}"
                    EnableRowVirtualization="True" 
                    EnableColumnVirtualization="True" 
                    VirtualizingPanel.IsVirtualizing="True" 
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    AutoGenerateColumns="True" 
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    SelectionMode="Single" 
                    SelectedIndex="{Binding SelectedIndexAvailableParameters}"
                    ColumnWidth="*"
                    RowHeight="23"
                    HorizontalAlignment="Stretch">
                </DataGrid>
                <Grid Grid.Row="0"  Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- sheet name grid -->
                    <DataGrid Grid.Row="0" Grid.Column="0" x:Name="dataGridSheetName"
                    ItemsSource="{Binding DataViewDocumentTypeSettings}"
                    VirtualizingPanel.IsVirtualizing="False" 
                    AutoGenerateColumns="False" 
                    CanUserSortColumns="False"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    SelectedIndex="{Binding SelectedIndexDocumentNameSetting}"
                    ColumnWidth="*"
                    RowHeight="23"
                    HorizontalAlignment="Stretch"
                    CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding [Sheet property]}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Suffix" Binding="{Binding Suffix}" IsReadOnly="False"/>
                            <DataGridTextColumn Header="Separator" Binding="{Binding Separator}" IsReadOnly="False"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- up and down button under document name grid -->
                    <Grid Grid.Row="1" Grid.Column="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Grid.Row="0"
                        Margin="0 5 5 5" 
                        Command="{Binding MoveUpCommand}" 
                        CommandParameter="{Binding ElementName=dataGridSheetName}">
                            <TextBlock Text="Up" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="1" Grid.Row="0"
                        Margin="5 5 0 5" 
                        Command="{Binding MoveDownCommand}" 
                        CommandParameter="{Binding ElementName=dataGridSheetName}">
                            <TextBlock Text="Down" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
                <!-- buttons add and remove -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Column="0" Grid.Row="1"
                    Margin="5 5 5 5" 
                    Command="{Binding MoveParameterToDocumentNameTableCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="Add Parameter" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="0" Grid.Row="2"
                    Margin="5 5 5 5" 
                    Command="{Binding RemoveParameterFromDocumentNameTableCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="Remove Parameter" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <!-- export and import buttons -->
        <Border Grid.Row="4" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0"
                    Margin="2 5 5 5" 
                    Content="Export" 
                    FontSize="18"
                    Click="Export_OnClick"/>
                <Button Grid.Row="0" Grid.Column="1"
                    Margin="5 5 2 5" 
                    Content="Import" 
                    FontSize="18"
                    Click="Import_OnClick"/>

                <!-- Hidden TextBoxes for binding -->
                <TextBox x:Name="ExportFilePathTextBox" Grid.Row="1" Grid.Column="0"
                    Text="{Binding ExportSettingsFilePath, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
                <!-- Hidden TextBoxes for binding -->
                <TextBox x:Name="ImportFilePathTextBox" Grid.Row="1" Grid.Column="1"
                    Text="{Binding ImportSettingsFilePath, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        <!-- save row content -->
        <Border Grid.Row="5" CornerRadius="1" BorderBrush="Gray" BorderThickness="1" Margin="0 2 0 2">
            <Grid Margin="5 2 5 2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                Margin="2 5 2 5" 
                Content="Save To Project" 
                FontSize="24"
                Command="{Binding SaveAndCloseCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
