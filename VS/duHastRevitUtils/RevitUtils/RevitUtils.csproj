<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>duHastNet.RevitUtils</RootNamespace>
    <AssemblyName>RevitUtils.25.0.1.1</AssemblyName>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Suppress assembly version conflict warnings -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- Auto-generate binding redirects -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Revit 2025 API References (.NET 8) -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\\..\\_References\\Autodesk\\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Reference to your converted Utils library -->
  <ItemGroup>
    <Reference Include="Utils.25.0.1.1">
      <HintPath>..\\..\\_References\\duHast\\Utils.25.0.1.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FileIOWrapper.25.0.1.1">
      <HintPath>..\\..\\_References\\duHast\\FileIOWrapper.25.0.1.1.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>